# LabanAI Environment Configuration (Example)
# Duplicate this file as .env and fill in your local settings.

PORT=3000
HOST=127.0.0.1
NODE_ENV=development
LABANAI_RIASEC27_PREVIEW=true

# Groq Cloud AI Explanation Service
# Obtain API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_EXPLANATION_PROVIDER=groq

# Optional: HMAC-SHA256 secret for signing local explanation context tokens
# RIASEC27_CONTEXT_SECRET=your_context_secret_here
