<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Hệ Thống La Bàn AI</title>

    <!-- 1. SCRIPT CHỐNG CHỚP NHÁY TRẮNG (ANTI-FOUC) -->
    <script>
        (function () {
            try {
                const savedTheme = localStorage.getItem('laban_theme');
                const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            } catch (err) {}
        })();
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        window.AUTH_USER = <%- JSON.stringify(currentUser || null).replace(/</g, '\\u003c') %>;
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        background: 'rgb(var(--bg-primary) / <alpha-value>)',
                        surface: 'rgb(var(--bg-surface) / <alpha-value>)',
                        cyan: { DEFAULT: 'rgb(var(--accent-cyan) / <alpha-value>)' },
                        ocean: { DEFAULT: 'rgb(var(--accent-ocean) / <alpha-value>)' },
                        violet: { DEFAULT: 'rgb(var(--accent-violet) / <alpha-value>)' },
                        emerald: { DEFAULT: '#10B981', lime: '#84CC16' },
                        navy: 'rgb(var(--text-primary) / <alpha-value>)',
                        muted: 'rgb(var(--text-muted) / <alpha-value>)'
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/css/styles.css">
    <%- locals.extraHead || '' %>
</head>
<body class="bg-background text-navy antialiased overflow-x-hidden selection:bg-cyan selection:text-white flex min-h-screen relative">

    <!-- DẢI SÓNG LỤA 3D AURORA MESH GRADIENT CHUẨN HÌNH MẪU -->
    <div class="aurora-stage" aria-hidden="true">
        <div class="aurora-ambient-left"></div>
        <div class="aurora-ambient-right"></div>
        <svg class="aurora-silk-svg" viewBox="0 0 1440 900" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <!-- Gradient dải lụa Ngọc Bích - Cyan - Tím bên trái -->
                <linearGradient id="aurora-left-ribbon" x1="0%" y1="20%" x2="100%" y2="80%">
                    <stop offset="0%" stop-color="#00F5D4" stop-opacity="0.75" />
                    <stop offset="32%" stop-color="#00BBF9" stop-opacity="0.55" />
                    <stop offset="65%" stop-color="#7B2CBF" stop-opacity="0.35" />
                    <stop offset="100%" stop-color="#0B1528" stop-opacity="0" />
                </linearGradient>

                <!-- Gradient dải lụa Tím Neon - Lam bên phải -->
                <linearGradient id="aurora-right-ribbon" x1="100%" y1="30%" x2="0%" y2="85%">
                    <stop offset="0%" stop-color="#9D4EDD" stop-opacity="0.8" />
                    <stop offset="35%" stop-color="#5A189A" stop-opacity="0.55" />
                    <stop offset="70%" stop-color="#00B4D8" stop-opacity="0.2" />
                    <stop offset="100%" stop-color="#0B1528" stop-opacity="0" />
                </linearGradient>

                <!-- Đường viền sáng mảnh trên đỉnh sóng lụa -->
                <linearGradient id="aurora-crest-glow" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#56CFE1" stop-opacity="0.85" />
                    <stop offset="35%" stop-color="#72EFDD" stop-opacity="0.4" />
                    <stop offset="65%" stop-color="#9D4EDD" stop-opacity="0.5" />
                    <stop offset="100%" stop-color="#C77DFF" stop-opacity="0.85" />
                </linearGradient>

                <filter id="silk-blur" x="-10%" y="-10%" width="120%" height="120%">
                    <feGaussianBlur stdDeviation="18" />
                </filter>
            </defs>

            <!-- Lớp sóng lụa Cyan-Violet uốn từ trái sang giữa -->
            <path filter="url(#silk-blur)" fill="url(#aurora-left-ribbon)"
                  d="M-120,470 C80,430 240,510 430,610 C620,710 780,760 980,740 L980,920 L-120,920 Z" />

            <!-- Lớp sóng lụa Tím-Lam uốn từ phải xuống giữa -->
            <path filter="url(#silk-blur)" fill="url(#aurora-right-ribbon)"
                  d="M460,760 C680,720 880,580 1120,510 C1280,465 1390,480 1540,540 L1540,920 L460,920 Z" />

            <!-- Sống lưng ánh sáng sắc nét tạo hiệu ứng lụa 3D như Hình 2 -->
            <path fill="none" stroke="url(#aurora-crest-glow)" stroke-width="3" opacity="0.55" filter="url(#silk-blur)"
                  d="M-80,475 C120,435 260,520 470,630 C690,745 960,550 1210,495 C1340,468 1420,490 1500,525" />
        </svg>
    </div>

    <div class="sweeping-light"></div>
    
    <div id="layout-container"></div>