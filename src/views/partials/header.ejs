<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Hệ Thống La Bàn AI</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#FAFCFF',
                        surface: '#FFFFFF',
                        cyan: { DEFAULT: '#00B4D8' },
                        ocean: { DEFAULT: '#0077B6' },
                        violet: { DEFAULT: '#7B2CBF' },
                        emerald: { DEFAULT: '#10B981', lime: '#84CC16' },
                        navy: '#0F172A',
                        muted: '#64748B'
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/css/styles.css">
    <!-- Nơi render các thư viện/CSS đặc thù của từng trang -->
    <%- locals.extraHead || '' %>
</head>
<body class="bg-background text-navy antialiased overflow-x-hidden selection:bg-cyan selection:text-white flex min-h-screen">

    <div class="sweeping-light"></div>
    
    <div id="layout-container"></div>