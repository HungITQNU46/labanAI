<%- include('../partials/header', { 
    extraHead: `<style>
        .option-label:hover { border-color: #00B4D8; background-color: rgba(0, 180, 216, 0.04); }
        .option-radio:checked + span { color: #0077B6; font-weight: 700; }
        .status-badge-ready { background-color: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; }
        .status-badge-conditional { background-color: #FFFBEB; color: #92400E; border: 1px solid #FDE68A; }
        .status-badge-unresolved { background-color: #FEF2F2; color: #991B1B; border: 1px solid #FECACA; }
    </style>`
}) %>

<div id="main-wrapper" class="w-full min-h-screen flex flex-col items-center relative pt-12 pb-24 px-4 sm:px-8">
    <main class="w-full max-w-5xl relative flex flex-col pt-6">

        <!-- CẢNH BÁO NGHIÊN CỨU CHÍNH THỨC (BẮT BUỘC THEO B-06) -->
        <aside class="mb-8 p-5 rounded-3xl border border-amber-300 bg-amber-50/90 text-navy shadow-sm" role="note" aria-labelledby="research-notice-heading">
            <div class="flex items-start gap-3">
                <span class="rounded-full bg-amber-200 text-amber-900 px-3 py-1 text-xs font-black shrink-0 tracking-wider">BẢN THỬ NGHIỆM NỘI BỘ</span>
                <div>
                    <h2 id="research-notice-heading" class="text-sm font-bold text-amber-950">Cảnh báo phạm vi nghiên cứu (Hướng B — RIASEC27 / ML Q5)</h2>
                    <p class="text-xs text-amber-900 mt-1 leading-relaxed">
                        Đây là công cụ thử nghiệm nghiên cứu dựa trên 27 câu RIASEC và sáu mô hình dự đoán sở thích. Kết quả Top-3 hiện chỉ xét 21 ngành có hồ sơ nghề tham chiếu thử nghiệm; chưa được kiểm chứng về độ chính xác trong việc lựa chọn ngành đại học và không thay thế tư vấn hướng nghiệp trực tiếp.
                    </p>
                    <div class="mt-2 text-[11px] font-mono text-amber-800">
                        research_status: <span class="font-bold"><%= researchStatus %></span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- TIÊU ĐỀ TRANG -->
        <div class="mb-8">
            <h1 class="text-2xl sm:text-3xl font-black text-navy tracking-tight">Khảo sát 27 câu RIASEC & Khám phá 33 Ngành</h1>
            <p class="text-sm text-muted mt-1">Trang thử nghiệm kỹ thuật Hướng B dành riêng cho môi trường phát triển nội bộ. Không sử dụng cho quyết định tuyển sinh chính thức.</p>
        </div>

        <!-- PHẦN 1: BÀI KHẢO SÁT 27 CÂU RIASEC -->
        <section id="riasec27-survey-panel" class="glass-card rounded-3xl p-6 sm:p-8 mb-10 shadow-sm border border-slate-200">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
                <div>
                    <h3 class="text-lg font-bold text-navy flex items-center gap-2">
                        <span>1. Bài khảo sát 27 nhận định RIASEC (CODEBOOK_33)</span>
                    </h3>
                    <p class="text-xs text-muted mt-1">Đánh giá mức độ đồng ý từ 1 (Hoàn toàn không đồng ý) đến 5 (Hoàn toàn đồng ý).</p>
                </div>
                <div class="bg-cyan/10 text-ocean px-4 py-2 rounded-2xl text-xs font-bold" id="riasec27-counter">
                    Đã hoàn thành: <span id="answered-count">0</span> / 27 câu
                </div>
            </div>

            <!-- FORM 27 CÂU HỎI -->
            <form id="riasec27-form" novalidate>
                <div id="questions-list" class="space-y-6">
                    <!-- Danh sách 27 câu sẽ được render động từ JSON codebook -->
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
                    <button type="button" id="btn-reset-answers" class="px-5 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-navy hover:bg-slate-50 transition">
                        Làm lại từ đầu
                    </button>
                    <button type="submit" id="btn-submit-riasec" disabled class="btn-gradient px-7 py-3 rounded-xl text-white font-bold text-sm shadow-md disabled:opacity-40 disabled:cursor-not-allowed transition">
                        Gửi tính điểm ML Top-3
                    </button>
                </div>
            </form>
        </section>

        <!-- PHẦN 2: KẾT QUẢ XẾP HẠNG ML TOP-3 (CHỈ 21 NGÀNH READY) -->
        <section id="riasec27-results-panel" class="hidden glass-card rounded-3xl p-6 sm:p-8 mb-10 shadow-sm border border-slate-200">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
                <div>
                    <h3 class="text-lg font-bold text-navy flex items-center gap-2">
                        <span>2. Kết quả xếp hạng ML Top-3 (21 ngành READY)</span>
                    </h3>
                    <p class="text-xs text-muted mt-1">Điểm tương quan Pearson profile similarity; tuyệt đối không phải xác suất đỗ đại học.</p>
                </div>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-mono font-semibold text-slate-600">P2 ML Ranker</span>
            </div>

            <!-- NỘI DUNG KẾT QUẢ DYNAMIC -->
            <div id="results-content" class="space-y-6">
                <!-- SUCCESS, ABSTAIN_FLAT_PROFILE, TIED_BOUNDARY render tại đây -->
            </div>
        </section>

        <!-- PHẦN 3: TRA CỨU SỔ BỘ 33 NGÀNH -->
        <section id="riasec27-catalog-panel" class="glass-card rounded-3xl p-6 sm:p-8 mb-10 shadow-sm border border-slate-200">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
                <div>
                    <h3 class="text-lg font-bold text-navy">3. Sổ bộ danh mục 33 ngành đại học</h3>
                    <p class="text-xs text-muted mt-1">Minh bạch trạng thái dữ liệu khoa học, điều kiện tham gia xếp hạng tự động và nguồn minh chứng CTĐT.</p>
                </div>
                <!-- TABS LỌC -->
                <div class="flex flex-wrap gap-2 text-xs font-semibold">
                    <button type="button" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-navy text-white" data-filter="ALL">Tất cả (33)</button>
                    <button type="button" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="READY">Đủ điều kiện ML (21 READY)</button>
                    <button type="button" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="CONDITIONAL">Chờ minh chứng (10 CONDITIONAL)</button>
                    <button type="button" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="UNRESOLVED">Chưa ánh xạ (2 UNRESOLVED)</button>
                </div>
            </div>

            <div id="catalog-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="col-span-full py-8 text-center text-sm text-muted">Đang tải danh mục 33 ngành...</div>
            </div>
        </section>

        <!-- PHẦN 4: KHÁM PHÁ ĐỊNH TÍNH TIER 2 (5 CHỦ ĐỀ) -->
        <section id="riasec27-tier2-panel" class="glass-card rounded-3xl p-6 sm:p-8 mb-10 shadow-sm border border-slate-200">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
                <div>
                    <h3 class="text-lg font-bold text-navy">4. Khám phá định tính Tier 2 (5 Chủ đề chuyên môn)</h3>
                    <p class="text-xs text-muted mt-1">Học sinh chủ động chọn hướng quan tâm để làm rõ sở thích học tập. Kết quả hoàn toàn mang tính định tính, không can thiệp hay thay đổi Top-3 ML.</p>
                </div>
                <span class="rounded-full bg-cyan/10 text-ocean px-3 py-1 text-xs font-bold">KHÔNG TÍNH ĐIỂM SỐ</span>
            </div>

            <!-- DANH SÁCH 5 CHỦ ĐỀ -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6" id="themes-grid">
                <!-- 5 theme cards -->
            </div>

            <!-- MODAL HOẶC KHU VỰC CÂU HỎI TIER 2 -->
            <div id="tier2-question-box" class="hidden p-6 rounded-2xl bg-slate-50 border border-slate-200">
                <div class="flex items-center justify-between mb-3">
                    <span id="tier2-theme-title" class="text-xs font-bold text-ocean uppercase tracking-wider">Chủ đề phân hóa</span>
                    <button type="button" id="btn-close-tier2" class="text-xs text-muted hover:text-navy font-semibold">Đóng / Quay lại</button>
                </div>
                <h4 id="tier2-question-text" class="text-base font-bold text-navy mb-4">Câu hỏi phân hóa chuyên sâu</h4>

                <form id="tier2-form">
                    <div id="tier2-options-container" class="space-y-3 mb-6">
                        <!-- Options render tại đây -->
                    </div>
                    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-200">
                        <button type="button" id="btn-skip-tier2" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-100">
                            Bỏ qua câu hỏi này
                        </button>
                        <button type="submit" id="btn-submit-tier2" class="btn-gradient px-5 py-2 rounded-xl text-white text-xs font-bold shadow-sm">
                            Xem thông tin khám phá
                        </button>
                    </div>
                </form>

                <!-- KHU VỰC HIỂN THỊ KẾT QUẢ ĐỊNH TÍNH TIER 2 -->
                <div id="tier2-result-box" class="hidden mt-6 p-5 rounded-xl bg-white border border-slate-200 shadow-sm">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-bold px-2.5 py-0.5">ĐỊNH HƯỚNG KHÁM PHÁ</span>
                        <span id="tier2-focus-tag" class="text-xs font-bold text-navy"></span>
                    </div>
                    <p id="tier2-guidance-text" class="text-sm text-slate-700 leading-relaxed mb-4"></p>
                    <div id="tier2-steps-container">
                        <h5 class="text-xs font-bold text-navy uppercase tracking-wider mb-2">Gợi ý hoạt động trải nghiệm tiếp theo:</h5>
                        <ul id="tier2-steps-list" class="list-disc list-inside text-xs text-slate-600 space-y-1"></ul>
                    </div>
                </div>
            </div>
        </section>

    </main>
</div>

<!-- Nạp dữ liệu câu hỏi từ Server vào DOM Script an toàn -->
<script id="riasec27-data" type="application/json"><%- questionnaireData %></script>
<script src="/js/riasec27-preview.js"></script>

<%- include('../partials/footer') %>
