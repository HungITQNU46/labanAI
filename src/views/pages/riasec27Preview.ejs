<%- include('../partials/header', { 
    extraHead: `<style>
        .option-label:hover { border-color: #00B4D8; background-color: rgba(0, 180, 216, 0.04); }
        .option-radio:checked + span { color: #0077B6; font-weight: 700; }
        .status-badge-ready { background-color: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; }
        .status-badge-conditional { background-color: #FFFBEB; color: #92400E; border: 1px solid #FDE68A; }
        .status-badge-unresolved { background-color: #FEF2F2; color: #991B1B; border: 1px solid #FECACA; }
    </style>`
}) %>

<div id="main-wrapper" class="ui-page w-full min-h-screen flex flex-col items-center relative pb-24 px-4 sm:px-8">
    <div class="fixed top-[-10%] right-[-5%] w-[400px] h-[400px] bg-cyan/10 rounded-full blur-[100px] -z-10"></div>
    <div class="fixed bottom-[-10%] left-[20%] w-[500px] h-[500px] bg-violet/10 rounded-full blur-[120px] -z-10"></div>

    <main class="w-full max-w-5xl relative flex flex-col">

        <header class="ui-page-header evaluation-page-header">
            <h1>Định hướng nghề nghiệp bằng AI</h1>
            <p>Trả lời 27 câu hỏi RIASEC để khám phá những ngành đại học bạn có thể tìm hiểu thêm.</p>
        </header>

        <!-- PHẦN 1: BÀI KHẢO SÁT 27 CÂU RIASEC -->
        <section id="riasec27-survey-panel" class="glass-card rounded-3xl p-6 sm:p-8 mb-10 shadow-sm border border-slate-200">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
                <div>
                    <h3 class="text-lg font-bold text-navy flex items-center gap-2">
                        <span>1. Khảo sát 27 câu RIASEC</span>
                    </h3>
                    <p class="text-xs text-muted mt-1">Đánh giá mức độ đồng ý từ 1 (Hoàn toàn không đồng ý) đến 5 (Hoàn toàn đồng ý).</p>
                </div>
                <div class="bg-cyan/10 text-ocean px-4 py-2 rounded-2xl text-xs font-bold" id="riasec27-counter">
                    Đã hoàn thành: <span id="answered-count">0</span> / 27 câu
                </div>
            </div>

            <!-- FORM 27 CÂU HỎI -->
            <form id="riasec27-form" novalidate>
                <div id="questions-list" class="space-y-6">
                    <!-- Danh sách 27 câu sẽ được render động từ JSON codebook -->
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
                    <button type="button" id="btn-reset-answers" class="px-5 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-navy hover:bg-slate-50 transition">
                        Làm lại từ đầu
                    </button>
                    <button type="submit" id="btn-submit-riasec" disabled class="btn-gradient px-7 py-3 rounded-xl text-white font-bold text-sm shadow-md disabled:opacity-40 disabled:cursor-not-allowed transition">
                        Xem kết quả
                    </button>
                </div>
            </form>
        </section>

        <!-- PHẦN 2: KẾT QUẢ XẾP HẠNG ML TOP-3 (CHỈ 21 NGÀNH READY) -->
        <section id="riasec27-results-panel" class="hidden scroll-mt-24 glass-card rounded-3xl p-6 sm:p-8 mb-10 shadow-sm border border-slate-200">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
                <div>
                    <h3 class="text-lg font-bold text-navy flex items-center gap-2">
                        <span>2. Kết quả Top-3 ngành đại học</span>
                    </h3>
                    <p id="result-reference-note" class="text-xs text-muted mt-1" role="note">Kết quả mang tính tham khảo, không thay thế tư vấn hướng nghiệp.</p>
                </div>
            </div>

            <!-- NỘI DUNG KẾT QUẢ DYNAMIC -->
            <div id="results-content" class="space-y-6">
                <!-- SUCCESS, ABSTAIN_FLAT_PROFILE, TIED_BOUNDARY render tại đây -->
            </div>

            <div id="ai-explanation-controls" class="hidden mt-5">
                <button id="btn-explain-ai" type="button" class="btn-gradient rounded-xl px-5 py-3 text-sm font-bold text-white">Giải thích kết quả bằng Groq AI</button>
                <div id="ai-explanation-panel" class="hidden mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:p-5" aria-labelledby="ai-explanation-heading">
                    <div class="flex items-start justify-between gap-3">
                        <h4 id="ai-explanation-heading" class="font-bold text-navy">Giải thích kết quả bằng Groq AI</h4>
                        <button id="btn-close-ai-explanation" type="button" class="text-xs font-semibold text-slate-600">Đóng</button>
                    </div>
                    <p id="ai-data-disclosure" class="mt-3 text-xs leading-relaxed text-slate-600">Khi bạn đồng ý, LabanAI gửi ba ngành đã xếp hạng, thông tin nghề O*NET, chỉ số tương đồng và hồ sơ RIASEC sáu chiều đã xử lý tới API Groq Cloud để tạo giải thích. Không gửi 27 đáp án thô hoặc thông tin định danh. Nội dung giải thích có thể có sai sót.</p>
                    <p class="mt-2 text-xs leading-relaxed text-slate-600">Nhà cung cấp có chính sách lưu giữ dữ liệu riêng. <a href="https://console.groq.com/docs/your-data" target="_blank" rel="noopener noreferrer" class="underline text-ocean">Xem chính sách dữ liệu API</a>.</p>
                    <label class="mt-4 flex items-start gap-2 text-xs leading-relaxed text-slate-700">
                        <input id="ai-explanation-consent" type="checkbox" class="mt-0.5 accent-cyan">
                        <span>Tôi đồng ý gửi thông tin kết quả tối thiểu nêu trên tới nhà cung cấp AI để giải thích.</span>
                    </label>
                    <button id="btn-create-ai-explanation" type="button" disabled class="mt-3 rounded-xl bg-navy px-4 py-2.5 text-xs font-bold text-white disabled:opacity-40">Đồng ý gửi và tạo giải thích</button>
                    <p id="ai-explanation-status" role="status" aria-live="polite" class="mt-3 text-xs leading-relaxed text-slate-600"></p>
                    <div id="ai-explanation-content" class="mt-3 space-y-4 text-sm leading-relaxed text-slate-700"></div>
                </div>
            </div>
        </section>

    </main>
</div>

<!-- Nạp dữ liệu câu hỏi từ Server vào DOM Script an toàn -->
<script id="riasec27-data" type="application/json"><%- questionnaireData %></script>
<script src="/js/riasec27-preview.js"></script>

<%- include('../partials/footer', { extraScripts: '<script>if (typeof renderLayout === "function") renderLayout("nav-eval");</script>' }) %>
