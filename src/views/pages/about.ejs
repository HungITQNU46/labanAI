<%- include('../partials/header', { 
    extraHead: `
    <style>
        .brand-text { color: #0F172A; transition: color 0.2s ease-in-out; cursor: pointer; display: inline-block; }
        .brand-text:hover { color: #00B4D8 !important; }
        .brand-text .ai-part { color: #00B4D8 !important; }
    </style>` 
}) %>

<div id="main-wrapper" class="transition-all duration-300 w-full min-h-screen flex flex-col items-center relative pb-20">
    <section class="w-full relative overflow-hidden pt-32 pb-14 sm:pt-40 sm:pb-20 px-6">
        <div class="max-w-5xl mx-auto text-center space-y-5">
            <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-white border border-slate-200 text-slate-700 text-xs font-bold tracking-wide shadow-sm">
                <i data-lucide="award" class="w-4 h-4 text-cyan"></i>Thực hành Xây dựng Hệ thống Thông tin – Đại học Quy Nhơn
            </div>
            
            <h1 class="text-3xl sm:text-5xl font-black text-navy tracking-tight leading-tight">
                <span class="brand-text font-black">la bàn<span class="ai-part">.ai</span></span><br>
                <h1 class="text-2xl lg:text-3xl font-bold leading-tight text-navy mt-4">
                    Định vị tương lai, <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan to-violet">chọn đúng ngành học.</span>
                </h1>
            </h1>
            
            <div class="max-w-3xl mx-auto bg-white/90 backdrop-blur-md rounded-2xl p-6 sm:p-7 border border-slate-200/80 shadow-sm text-justify">
                <p class="text-sm sm:text-base text-navy/85 italic font-medium leading-relaxed">
                    "Dù bạn là học sinh đang bỡ ngỡ trước ngưỡng cửa đại học, một sinh viên còn loay hoay chưa biết ngành mình chọn đã đúng chưa, hay những phụ huynh canh cánh nỗi lo cho tương lai của con... <span class="brand-text font-bold">la bàn<span class="ai-part">.ai</span></span> luôn ở đây để cùng bạn tìm ra lối đi phù hợp nhất."
                </p>
            </div>
        </div>
    </section>

    <!-- CONTAINER GIỚI HẠN CHIỀU RỘNG NỘI DUNG CHÍNH -->
    <main class="w-full max-w-5xl px-4 sm:px-8 mt-12 space-y-16">
        <!-- 2. GIỚI THIỆU -->
        <section class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200/80 shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
                <div class="lg:col-span-7 space-y-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-extrabold text-cyan uppercase tracking-wider block">Giới thiệu tổng quan</span>
                        <h2 class="text-2xl sm:text-3xl font-black text-navy leading-snug">
                            Về hệ thống <span class="brand-text font-black">la bàn<span class="ai-part">.ai</span></span>
                        </h2>
                        <div class="w-16 h-1 bg-gradient-to-r from-cyan to-violet rounded-full"></div>
                    </div>
                    <div class="space-y-3.5 text-sm sm:text-base text-navy/80 leading-relaxed text-justify pt-2">
                        <p>Chúng mình hiểu rằng, việc lựa chọn một ngành học không đơn thuần là chọn một tên gọi trên giấy, mà là chọn con đường trải nghiệm cho những năm tháng thanh xuân và sự nghiệp tương lai.</p>
                        <p>Thực tế có rất nhiều bạn trẻ học xong mới nhận ra mình không hợp ngành, hay chật vật vì mất định hướng. <span class="brand-text font-bold">la bàn<span class="ai-part">.ai</span></span> ra đời từ chính sự thấu hiểu đó. Bằng việc ứng dụng trí tuệ nhân tạo kết hợp với các bài đánh giá năng lực, tính cách và sở thích cá nhân, hệ thống hỗ trợ người học thấu hiểu điểm mạnh và tự tin định hình lộ trình phát triển.</p>
                    </div>
                    <div class="pt-2">
                        <button onclick="handleStartAction()" class="px-6 py-2.5 rounded-xl btn-gradient text-white font-bold text-xs shadow hover-glow transition-all active:scale-95">
                            Khám phá tính năng
                        </button>
                    </div>
                </div>
                <div class="lg:col-span-5">
                    <div class="relative rounded-2xl overflow-hidden border border-slate-200 shadow-md group">
                        <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=800&q=80" alt="Sinh viên nghiên cứu công nghệ" class="w-full h-72 sm:h-80 object-cover group-hover:scale-105 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent"></div>
                        <span class="absolute bottom-3 left-3 bg-white/95 backdrop-blur-md text-navy text-[10px] font-bold px-3 py-1 rounded-lg shadow-sm">
                            Khoa Công nghệ Thông tin – QNU
                        </span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. LÝ DO BẠN TIN TƯỞNG -->
        <section class="space-y-8">
            <div class="text-center max-w-xl mx-auto space-y-2">
                <h2 class="text-2xl sm:text-3xl font-black text-navy uppercase tracking-tight">Lý Do Bạn Tin Tưởng Và Lựa Chọn Chúng Tôi</h2>
                <div class="flex items-center justify-center gap-2">
                    <div class="w-12 h-px bg-slate-300"></div><div class="w-2 h-2 rounded-full bg-cyan"></div><div class="w-12 h-px bg-slate-300"></div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Cột 1 -->
                <div class="bg-white rounded-3xl p-7 border border-slate-200/90 shadow-sm text-center flex flex-col items-center hover:border-cyan hover:shadow-md transition-all duration-300 group">
                    <div class="w-16 h-16 rounded-full border-2 border-dashed border-cyan/40 bg-cyan/5 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-cyan/10 transition-all">
                        <div class="w-12 h-12 rounded-full bg-cyan text-white flex items-center justify-center font-bold shadow-sm"><i data-lucide="user-check" class="w-6 h-6 stroke-[2.2]"></i></div>
                    </div>
                    <h3 class="font-black text-navy text-base mb-2 uppercase tracking-wide">Thấu hiểu bản thân</h3>
                    <p class="text-xs sm:text-sm text-navy/75 leading-relaxed text-justify">Nhận diện rõ thế mạnh, sở thích và tiềm năng ẩn giấu thông qua trắc nghiệm hướng nghiệp chuẩn hóa Holland RIASEC.</p>
                </div>
                <!-- Cột 2 -->
                <div class="bg-white rounded-3xl p-7 border border-slate-200/90 shadow-sm text-center flex flex-col items-center hover:border-violet hover:shadow-md transition-all duration-300 group">
                    <div class="w-16 h-16 rounded-full border-2 border-dashed border-violet/40 bg-violet/5 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-violet/10 transition-all">
                        <div class="w-12 h-12 rounded-full bg-violet text-white flex items-center justify-center font-bold shadow-sm"><i data-lucide="target" class="w-6 h-6 stroke-[2.2]"></i></div>
                    </div>
                    <h3 class="font-black text-navy text-base mb-2 uppercase tracking-wide">Gợi ý ngành chính xác</h3>
                    <p class="text-xs sm:text-sm text-navy/75 leading-relaxed text-justify">Phân tích dữ liệu thông minh để đưa ra các lựa chọn ngành nghề phù hợp nhất với năng lực và điểm thi của bạn.</p>
                </div>
                <!-- Cột 3 -->
                <div class="bg-white rounded-3xl p-7 border border-slate-200/90 shadow-sm text-center flex flex-col items-center hover:border-emerald hover:shadow-md transition-all duration-300 group">
                    <div class="w-16 h-16 rounded-full border-2 border-dashed border-emerald/40 bg-emerald/5 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-emerald/10 transition-all">
                        <div class="w-12 h-12 rounded-full bg-emerald text-white flex items-center justify-center font-bold shadow-sm"><i data-lucide="trending-up" class="w-6 h-6 stroke-[2.2]"></i></div>
                    </div>
                    <h3 class="font-black text-navy text-base mb-2 uppercase tracking-wide">Dự đoán & Định hướng</h3>
                    <p class="text-xs sm:text-sm text-navy/75 leading-relaxed text-justify">Cung cấp thông tin trực quan về xác suất trúng tuyển và xu hướng lao động, giúp bạn tự tin đưa ra quyết định cho tương lai.</p>
                </div>
            </div>
        </section>

        <!-- 4. ĐỘI NGŨ PHÁT TRIỂN -->
        <section class="space-y-8">
            <div class="text-center max-w-xl mx-auto space-y-1">
                <span class="text-xs font-bold text-violet uppercase tracking-wider block">Tâm huyết nghiên cứu</span>
