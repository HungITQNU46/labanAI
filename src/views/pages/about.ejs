<%- include('../partials/header') %>

<div id="main-wrapper" class="transition-all duration-300 w-full min-h-screen flex flex-col items-center relative pb-20 z-10">
    <!-- 1. HERO SECTION -->
    <section class="w-full relative overflow-hidden pt-32 pb-14 sm:pt-40 sm:pb-20 px-6">
        <div class="max-w-5xl mx-auto text-center space-y-5">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-card border border-slate-200 dark:border-white/15 text-navy text-xs font-bold tracking-wide shadow-sm">
                <i data-lucide="award" class="w-4 h-4 text-cyan"></i> Thực hành Xây dựng Hệ thống Thông tin – Đại học Quy Nhơn
            </div>
            
            <div class="space-y-4">
                <h1 class="text-3xl sm:text-5xl font-black text-navy tracking-tight leading-tight">
                    <span class="brand-text font-black">la bàn<span class="ai-part text-cyan">.ai</span></span>
                </h1>
                <p class="text-2xl lg:text-3xl font-bold leading-tight text-navy">
                    Định vị tương lai, <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan to-violet">chọn đúng ngành học.</span>
                </p>
            </div>
            
            <div class="max-w-3xl mx-auto glass-card rounded-2xl p-6 sm:p-7 border border-slate-200/80 dark:border-white/10 shadow-sm text-justify">
                <p class="text-sm sm:text-base text-navy/85 italic font-medium leading-relaxed">
                    "Dù bạn là học sinh đang bỡ ngỡ trước ngưỡng cửa đại học, một sinh viên còn loay hoay chưa biết ngành mình chọn đã đúng chưa, hay những phụ huynh canh cánh nỗi lo cho tương lai của con... <span class="brand-text font-bold">la bàn<span class="ai-part text-cyan">.ai</span></span> luôn ở đây để cùng bạn tìm ra lối đi phù hợp nhất."
                </p>
            </div>
        </div>
    </section>

    <!-- CONTAINER NỘI DUNG CHÍNH -->
    <main class="w-full max-w-5xl px-4 sm:px-8 mt-8 space-y-16">
       
        <section class="glass-card rounded-3xl p-8 sm:p-10 border border-slate-200/80 dark:border-white/10 shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
                <!-- Cột chữ: đổi từ 7 -> 6 cột để nhường thêm chiều ngang cho ảnh -->
                <div class="lg:col-span-6 space-y-4">
                    <div class="space-y-1.5">
                        <span class="text-xs font-extrabold text-cyan uppercase tracking-wider block">Giới thiệu tổng quan</span>
                        <h2 class="text-2xl sm:text-3xl font-black text-navy leading-snug">
                            Về hệ thống <span class="brand-text font-black">la bàn<span class="ai-part text-cyan">.ai</span></span>
                        </h2>
                        <div class="w-16 h-1 bg-gradient-to-r from-cyan to-violet rounded-full"></div>
                    </div>
                    <div class="space-y-3.5 text-sm sm:text-base text-navy/80 leading-relaxed text-justify pt-2">
                        <p>Chúng mình hiểu rằng, việc lựa chọn một ngành học không đơn thuần là chọn một tên gọi trên giấy, mà là chọn con đường trải nghiệm cho những năm tháng thanh xuân và sự nghiệp tương lai.</p>
                        <p>Thực tế có rất nhiều bạn trẻ học xong mới nhận ra mình không hợp ngành, hay chật vật vì mất định hướng. <span class="brand-text font-bold">la bàn<span class="ai-part text-cyan">.ai</span></span> ra đời từ chính sự thấu hiểu đó. Bằng việc ứng dụng trí tuệ nhân tạo kết hợp với các bài đánh giá năng lực, tính cách và sở thích cá nhân, hệ thống hỗ trợ người học thấu hiểu điểm mạnh và tự tin định hình lộ trình phát triển.</p>
                    </div>
                    <div class="pt-2">
                        <button onclick="handleStartAction()" class="px-6 py-2.5 rounded-xl btn-gradient text-white font-bold text-xs shadow hover-glow transition-all active:scale-95">
                            Khám phá tính năng
                        </button>
                    </div>
                </div>

                <!-- Cột ảnh: mở rộng lên 6 cột, bỏ chiều cao cứng để ảnh tự bung đúng tỷ lệ gốc -->
                <div class="lg:col-span-6">
                    <div class="relative rounded-2xl overflow-hidden border border-slate-200/80 dark:border-white/15 shadow-lg group">
                        <img
                            src="/images/team/dai-hoc-quy-nhon.jpg"
                            alt="Trường Đại học Quy Nhơn - Khoa Công nghệ Thông tin"
                            loading="lazy"
                            class="w-full h-auto block group-hover:scale-105 transition-transform duration-500"
                        >
                        <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-slate-950/75 via-slate-950/25 to-transparent pointer-events-none"></div>
                        <span class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-md !text-white border border-white/20 text-[11px] font-bold px-3 py-1 rounded-lg shadow-sm">
                            Khoa Công nghệ Thông tin – Đại học Quy Nhơn
                        </span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. LÝ DO BẠN TIN TƯỞNG -->
        <section class="space-y-8">
            <div class="text-center max-w-xl mx-auto space-y-2">
                <h2 class="text-2xl sm:text-2.9xl font-black text-navy uppercase tracking-tight">Lý Do Bạn Tin Tưởng Và Lựa Chọn Chúng Tôi</h2>
                <div class="flex items-center justify-center gap-2">
                    <div class="w-12 h-px bg-slate-300 dark:bg-white/20"></div>
                    <div class="w-2 h-2 rounded-full bg-cyan"></div>
                    <div class="w-12 h-px bg-slate-300 dark:bg-white/20"></div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="glass-card rounded-3xl p-7 border border-slate-200/90 dark:border-white/10 shadow-sm text-center flex flex-col items-center hover:border-cyan hover:shadow-md transition-all duration-300 group">
                    <div class="w-16 h-16 rounded-full border-2 border-dashed border-cyan/40 bg-cyan/5 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-cyan/10 transition-all">
                        <div class="w-12 h-12 rounded-full bg-cyan text-white flex items-center justify-center font-bold shadow-sm"><i data-lucide="user-check" class="w-6 h-6 stroke-[2.2]"></i></div>
                    </div>
                    <h3 class="font-black text-navy text-base mb-2 uppercase tracking-wide">Thấu hiểu bản thân</h3>
                    <p class="text-xs sm:text-sm text-navy/75 leading-relaxed text-justify">Nhận diện rõ thế mạnh, sở thích và tiềm năng ẩn giấu thông qua trắc nghiệm hướng nghiệp chuẩn hóa Holland RIASEC.</p>
                </div>
                <div class="glass-card rounded-3xl p-7 border border-slate-200/90 dark:border-white/10 shadow-sm text-center flex flex-col items-center hover:border-violet hover:shadow-md transition-all duration-300 group">
                    <div class="w-16 h-16 rounded-full border-2 border-dashed border-violet/40 bg-violet/5 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-violet/10 transition-all">
                        <div class="w-12 h-12 rounded-full bg-violet text-white flex items-center justify-center font-bold shadow-sm"><i data-lucide="target" class="w-6 h-6 stroke-[2.2]"></i></div>
                    </div>
                    <h3 class="font-black text-navy text-base mb-2 uppercase tracking-wide">Gợi ý ngành chính xác</h3>
                    <p class="text-xs sm:text-sm text-navy/75 leading-relaxed text-justify">Phân tích dữ liệu thông minh để đưa ra các lựa chọn ngành nghề phù hợp nhất với năng lực và điểm thi của bạn.</p>
                </div>
                <div class="glass-card rounded-3xl p-7 border border-slate-200/90 dark:border-white/10 shadow-sm text-center flex flex-col items-center hover:border-emerald hover:shadow-md transition-all duration-300 group">
                    <div class="w-16 h-16 rounded-full border-2 border-dashed border-emerald/40 bg-emerald/5 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-emerald/10 transition-all">
                        <div class="w-12 h-12 rounded-full bg-emerald text-white flex items-center justify-center font-bold shadow-sm"><i data-lucide="trending-up" class="w-6 h-6 stroke-[2.2]"></i></div>
                    </div>
                    <h3 class="font-black text-navy text-base mb-2 uppercase tracking-wide">Dự đoán & Định hướng</h3>
                    <p class="text-xs sm:text-sm text-navy/75 leading-relaxed text-justify">Cung cấp thông tin trực quan về xác suất trúng tuyển và xu hướng lao động, giúp bạn tự tin đưa ra quyết định cho tương lai.</p>
                </div>
            </div>
        </section>

        <!-- 4. ĐỘI NGŨ PHÁT TRIỂN & NGƯỜI HƯỚNG DẪN (THẺ ẢNH TRÀN VIỀN CHUYÊN NGHIỆP) -->
        <%
            const teamMembers = [
                {
                    name: 'Cao Thị Thanh Ngân',
                    role: 'Sinh viên phát triển',
                    dept: 'Khoa CNTT',
                    img: '/images/team/ngan.jpg',
                    imgClass: 'object-[42%_20%]',
                    accentBorder: 'hover:border-cyan',
                    badgeStyle: 'bg-cyan/10 dark:bg-cyan/20 border-cyan/30 text-cyan'
                },
                {
                    name: 'Văn Minh Thanh Thiệu',
                    role: 'Sinh viên phát triển',
                    dept: 'Khoa CNTT',
                    img: '/images/team/thieu.jpg',
                    imgClass: 'object-[48%_20%]',
                    accentBorder: 'hover:border-violet',
                    badgeStyle: 'bg-violet/10 dark:bg-violet/25 border-violet/30 text-violet dark:text-purple-300'
                },
                {
                    name: 'Đoàn Nguyễn Gia Hưng',
                    role: 'Sinh viên phát triển',
                    dept: 'Khoa CNTT',
                    img: '/images/team/hung.jpg',
                    imgClass: 'object-center',
                    accentBorder: 'hover:border-emerald',
                    badgeStyle: 'bg-emerald/10 dark:bg-emerald/20 border-emerald/30 text-emerald-600 dark:text-emerald-400'
                },
                {
                    name: 'Nguyễn Nhất Nguyên',
                    role: 'Sinh viên phát triển',
                    dept: 'Khoa CNTT',
                    img: '/images/team/nguyen.jpg',
                    imgClass: 'object-[49%_42%] scale-[1.85] origin-[49%_55%]',
                    accentBorder: 'hover:border-amber-400',
                    badgeStyle: 'bg-amber-500/10 dark:bg-amber-500/20 border-amber-400/35 text-amber-600 dark:text-amber-300'
                }
            ];
        %>

        <section class="space-y-8">
            <div class="text-center max-w-xl mx-auto space-y-1">
                <span class="text-xs font-bold text-violet uppercase tracking-wider block">Tâm huyết nghiên cứu</span>
                <h2 class="text-2xl sm:text-3xl font-black text-navy">Đội ngũ phát triển & Người hướng dẫn</h2>
            </div>

            <!-- Thẻ Giảng Viên Hướng Dẫn: Ảnh tràn viền toàn bộ nửa trái thẻ -->
            <div class="max-w-3xl mx-auto glass-card rounded-3xl overflow-hidden border border-slate-200/90 dark:border-white/15 shadow-lg group hover:border-violet/60 transition-all duration-300">
                <div class="grid grid-cols-1 md:grid-cols-12 items-stretch">
                    <div class="md:col-span-5 relative h-80 md:h-auto md:min-h-[300px] overflow-hidden bg-slate-900">
                        <img
                            src="/images/team/co-lien.jpg"
                            alt="ThS. Trần Thị Liên - Giảng viên hướng dẫn"
                            loading="lazy"
                            class="w-full h-full object-cover scale-[1.32] origin-[18%_76%] group-hover:scale-[1.38] transition-transform duration-500"
                        >
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-transparent md:bg-gradient-to-r md:from-transparent md:via-transparent md:to-slate-950/20 pointer-events-none"></div>
                    </div>
                    <div class="md:col-span-7 p-6 sm:p-8 flex flex-col justify-center text-left space-y-3">
                        <div>
                            <span class="inline-flex items-center gap-1.5 text-[11px] font-black text-violet uppercase tracking-widest bg-violet/10 border border-violet/20 px-3 py-1 rounded-full">
                                <i data-lucide="graduation-cap" class="w-3.5 h-3.5"></i> Giảng Viên Hướng Dẫn
                            </span>
                        </div>
                        <h3 class="text-2xl font-black text-navy tracking-tight">ThS. Trần Thị Liên</h3>
                        <div class="w-12 h-1 bg-gradient-to-r from-violet to-cyan rounded-full"></div>
                        <p class="text-xs sm:text-sm text-navy/80 leading-relaxed text-justify">
                            Người cô tận tụy luôn truyền cảm hứng, định hướng phương pháp và đồng hành sát sao cùng nhóm trong suốt quá trình nghiên cứu và hoàn thiện hệ thống <span class="brand-text font-bold">la bàn<span class="ai-part text-cyan">.ai</span></span>.
                        </p>
                    </div>
                </div>
            </div>

            <!-- 4 Thẻ Sinh Viên Phát Triển: Khung ảnh vuông 1:1 phía trên, thông tin tách riêng phía dưới -->
            <div class="space-y-5">
                <p class="text-xs sm:text-sm text-navy/80 leading-relaxed text-center max-w-2xl mx-auto">
                    Chúng mình là những sinh viên Công nghệ thông tin trẻ trung, nhiệt huyết, cùng chung ước mơ dùng công nghệ để giải quyết những trăn trở thực tế của các bạn trẻ:
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 pt-1">
                    <% teamMembers.forEach(function(member) { %>
                        <div class="glass-card rounded-3xl p-3 border border-slate-200/90 dark:border-white/15 shadow-sm <%= member.accentBorder %> hover:-translate-y-1.5 hover:shadow-xl transition-all duration-300 group flex flex-col">
                            <!-- Khung ảnh vuông 1:1 -->
                            <div class="relative w-full aspect-square rounded-2xl overflow-hidden bg-slate-900/10 dark:bg-slate-800/80">
                                <img
                                    src="<%= member.img %>"
                                    alt="<%= member.name %>"
                                    loading="lazy"
                                    class="w-full h-full object-cover transition-transform duration-500 <%= member.imgClass %>"
                                >
                            </div>

                            <!-- Phần thông tin tách riêng dưới ảnh -->
                            <div class="pt-4 pb-2 px-1.5 text-left flex-1 flex flex-col justify-between">
                                <div>
                                    <span class="inline-block text-[10px] font-bold border px-2.5 py-0.5 rounded-full <%= member.badgeStyle %>">
                                        <%= member.dept %>
                                    </span>
                                    <h4 class="font-black text-[15px] text-navy leading-snug tracking-tight mt-2.5">
                                        <%= member.name %>
                                    </h4>
                                    <p class="text-xs text-muted font-medium mt-1">
                                        <%= member.role %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- 5. KẾT NỐI -->
        <footer class="glass-card rounded-3xl p-8 sm:p-10 border border-slate-200 dark:border-white/10 shadow-xl space-y-8">
            <div class="max-w-3xl mx-auto space-y-4">
                <div class="text-center">
                    <span class="inline-block px-3 py-1 rounded-full bg-cyan/10 text-cyan text-xs font-bold uppercase tracking-wider mb-2">Lời nhắn gửi từ trái tim</span>
                    <h3 class="text-xl sm:text-2xl font-black text-navy leading-snug">"Kết nối với chúng tôi ngay hôm nay để bắt đầu hành trình thấu hiểu bản thân."</h3>
                </div>
                <p class="text-xs sm:text-sm text-navy/80 leading-relaxed text-justify">
                    Đừng để những băn khoăn hay sự mơ hồ làm chậm bước chân bạn; hãy để <span class="brand-text font-bold">la bàn<span class="ai-part text-cyan">.ai</span></span> trở thành người bạn đồng hành đáng tin cậy, cùng bạn mở ra cánh cửa tương lai tươi sáng và tràn đầy hứng khởi!
                </p>
                <blockquote class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-white/10 text-xs sm:text-sm text-navy/80 italic text-justify">
                    "Hãy xem <span class="brand-text font-bold">la bàn<span class="ai-part text-cyan">.ai</span></span> như một người bạn tri kỷ trên hành trình vươn ra biển lớn. Dù bạn đang ở bước khởi đầu hay đang muốn tìm một hướng đi mới, chúng mình luôn sẵn sàng lắng nghe và đồng hành!"
                </blockquote>
                <div class="pt-2 text-center">
                    <button onclick="handleStartAction()" class="btn-gradient px-8 py-3 rounded-2xl text-white font-bold text-xs shadow-md hover-glow inline-flex items-center gap-2 transition-all active:scale-95">
                        <i data-lucide="target" class="w-4 h-4"></i> Bắt đầu bài đánh giá ngay
                    </button>
                </div>
            </div>
            
            <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-muted border-t border-slate-200/70 dark:border-white/10">
                <div class="flex items-center gap-2 select-none">
                    <span class="brand-text font-extrabold text-navy">la bàn<span class="ai-part text-cyan">.ai</span></span>
                    <span>• Hệ thống tư vấn chọn ngành học</span>
                </div>
                <div class="flex items-center gap-3">
                    <span class="font-semibold text-navy">Kết nối với chúng tôi:</span>
                    <a href="https://www.facebook.com/share/1EGVr6S4iM/" target="_blank" class="w-9 h-9 rounded-full bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-white/10 hover:border-[#1877F2] hover:bg-[#1877F2]/10 flex items-center justify-center transition-all shadow-sm group"><svg class="w-4 h-4 fill-[#1877F2] group-hover:scale-110 transition-transform" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
                    <a href="https://zalo.me/g/3wsof2eseqcycwra4cyx" target="_blank" class="w-9 h-9 rounded-full bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-white/10 hover:border-[#0068FF] hover:bg-[#0068FF]/10 flex items-center justify-center transition-all shadow-sm group"><span class="font-black text-[11px] text-[#0068FF] group-hover:scale-110 transition-transform leading-none select-none">Zalo</span></a>
                    <a href="https://www.instagram.com/labai.ai?stkn=MWtyeWtqOXJlMWJrcg==" target="_blank" class="w-9 h-9 rounded-full bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-white/10 hover:border-[#E4405F] hover:bg-[#E4405F]/10 flex items-center justify-center transition-all shadow-sm group"><svg class="w-4 h-4 fill-[#E4405F] group-hover:scale-110 transition-transform" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
                </div>
            </div>
        </footer>
    </main>
</div>

<%- include('../partials/footer', { extraScripts: `<script>renderLayout('nav-about');</script>` }) %>