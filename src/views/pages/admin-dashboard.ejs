<%- include('../partials/header') %>

<button id="admin-brand-toggle" type="button" onclick="toggleAdminSidebar()" class="fixed left-4 top-3.5 z-[70] flex items-center gap-3 bg-transparent p-0 text-left sm:left-8" title="Nhấn vào logo để ẩn thanh điều hướng" aria-expanded="true">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[14px] bg-gradient-to-b from-[#00B4D8] to-[#7B2CBF] text-white shadow-md shadow-cyan/20 transition-transform duration-300 ease-out hover:rotate-45">
        <i data-lucide="compass" class="h-6 w-6 stroke-[2.2]"></i>
    </span>
    <span id="admin-brand-copy" class="text-left">
        <span class="block text-xl font-extrabold leading-none tracking-tight text-navy">la bàn<span class="text-cyan">.ai</span></span>
        <span class="mt-1 block text-[8.5px] font-bold uppercase tracking-widest text-slate-400">CHỌN NGÀNH, CHỌN TƯƠNG LAI</span>
    </span>
</button>
<div id="main-wrapper" class="min-h-screen w-full bg-background transition-all duration-300 md:ml-64">
    <button id="admin-sidebar-backdrop" type="button" onclick="toggleAdminSidebar()" class="fixed inset-0 z-[50] hidden bg-navy/40 md:hidden" aria-label="Đóng thanh điều hướng"></button>
    <aside id="admin-sidebar" class="fixed left-0 top-0 z-[60] flex h-screen w-64 -translate-x-full flex-col border-r border-navy/10 bg-surface/95 shadow-2xl backdrop-blur-xl transition-transform duration-300 md:translate-x-0">
        <nav class="flex-1 space-y-2 overflow-y-auto px-4 pb-7 pt-24 text-sm font-semibold">
            <button type="button" data-target="dashboard" class="admin-nav active flex w-full items-center justify-between gap-3 rounded-2xl border border-transparent bg-cyan/10 px-4 py-4 text-left text-cyan transition-colors hover:bg-cyan/10">
                <span class="flex items-center gap-3"><i data-lucide="layout-dashboard" class="h-5 w-5"></i> Trung tâm điều khiển</span>
            </button>
            <button type="button" data-target="accounts" class="admin-nav flex w-full items-center gap-3 rounded-2xl border border-transparent px-4 py-4 text-left text-muted transition-colors hover:bg-navy/5 hover:text-cyan">
                <i data-lucide="users" class="h-5 w-5"></i> Quản lý tài khoản
            </button>
            <button type="button" data-target="news" class="admin-nav flex w-full items-center gap-3 rounded-2xl border border-transparent px-4 py-4 text-left text-muted transition-colors hover:bg-navy/5 hover:text-cyan">
                <i data-lucide="newspaper" class="h-5 w-5"></i> Quản lý tin tức
            </button>
        </nav>

        <div class="border-t border-navy/10 p-4">
            <button onclick="logoutUser()" class="flex w-full items-center justify-center gap-2 rounded-xl p-3 text-sm font-bold text-red-500 transition-colors hover:bg-red-50">
                <i data-lucide="log-out" class="h-5 w-5"></i> Đăng xuất
            </button>
        </div>
    </aside>

    <main class="min-h-screen px-4 py-6 pt-20 sm:px-6 lg:px-8 md:pt-6">
        <div class="mx-auto max-w-7xl">
                <section id="dashboard" class="admin-panel space-y-6">
                    <div class="glass-card rounded-3xl border border-navy/5 p-5 shadow-lg">
                        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                            <div>
                                <h2 class="mt-3 text-2xl font-black text-navy">Trung tâm điều khiển</h2>
                            </div>
                            <div class="flex flex-wrap items-center gap-3">
                                <button id="export-dashboard" type="button" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-cyan to-violet px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:opacity-90">
                                    <i data-lucide="download" class="h-4 w-4"></i>
                                    Xuất Excel
                                </button>
                                <div class="flex items-center gap-2 rounded-2xl border border-navy/10 bg-slate-50 px-3 py-2 text-xs font-semibold text-muted">
                                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                                    Hệ thống hoạt động bình thường
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                        <div data-export-summary class="glass-card rounded-3xl border border-navy/5 p-5 shadow-sm">
                            <div class="flex items-center justify-between">
                                <p class="text-xs font-bold uppercase tracking-[0.18em] text-muted">Người dùng</p>
                                <span class="rounded-xl bg-cyan/10 p-2 text-cyan"><i data-lucide="users" class="w-4 h-4"></i></span>
                            </div>
                            <p class="mt-4 text-3xl font-black text-navy">12.155</p>
                        </div>
                        <div data-export-summary class="glass-card rounded-3xl border border-navy/5 p-5 shadow-sm">
                            <div class="flex items-center justify-between">
                                <p class="text-xs font-bold uppercase tracking-[0.18em] text-muted">Đã làm bài đánh giá</p>
                                <span class="rounded-xl bg-emerald/10 p-2 text-emerald"><i data-lucide="newspaper" class="w-4 h-4"></i></span>
                            </div>
                            <p class="mt-4 text-3xl font-black text-navy">8.742</p>
                        </div>
                        <div data-export-summary class="glass-card rounded-3xl border border-navy/5 p-5 shadow-sm">
                            <div class="flex items-center justify-between">
                                <p class="text-xs font-bold uppercase tracking-[0.18em] text-muted">Số lượng bài viết</p>
                                <span class="rounded-xl bg-amber/10 p-2 text-amber-500"><i data-lucide="newspaper" class="w-4 h-4"></i></span>
                            </div>
                            <p class="mt-4 text-3xl font-black text-navy">58</p>
                        </div>
                    </div>

                    <div class="grid gap-6 xl:grid-cols-[1.4fr_1fr]">
                        <section class="glass-card overflow-hidden rounded-2xl border border-navy/10 shadow-sm">
                            <div class="flex flex-col gap-4 border-b border-navy/10 px-6 py-6 sm:flex-row sm:items-center sm:justify-between">
                                <div>
                                    <h3 class="text-2xl font-bold text-navy">Hoạt động tư vấn</h3>
                                    <p class="mt-1 text-sm text-muted">Số lượt hoàn thành trong 7 ngày gần nhất</p>
                                </div>
                                <div class="flex items-center justify-between gap-4 rounded-md border border-navy/10 px-4 py-3 text-sm text-muted sm:min-w-48">
                                    <span>7 ngày qua</span>
                                    <i data-lucide="chevron-down" class="h-5 w-5"></i>
                                </div>
                            </div>
                            <div class="px-6 pb-6 pt-8 sm:px-10 sm:pt-10">
                                <div role="img" aria-label="Biểu đồ hoạt động tư vấn từ thứ Hai đến Chủ nhật" class="relative h-56 border-b border-navy/10 sm:h-64">
                                    <div class="absolute inset-x-0 top-1/4 border-t-2 border-slate-100"></div>
                                    <div class="absolute inset-x-0 top-2/4 border-t-2 border-slate-100"></div>
                                    <div class="absolute inset-x-0 top-3/4 border-t-2 border-slate-100"></div>
                                    <div class="absolute inset-0 flex items-end justify-around gap-3">
                                        <div class="h-[54%] w-[7%] rounded-t-md bg-cyan/30"></div>
                                        <div class="h-[71%] w-[7%] rounded-t-md bg-violet/35"></div>
                                        <div class="h-[46%] w-[7%] rounded-t-md bg-cyan/30"></div>
                                        <div class="h-[92%] w-[7%] rounded-t-md bg-ocean"></div>
                                        <div class="h-[77%] w-[7%] rounded-t-md bg-cyan/40"></div>
                                        <div class="h-[64%] w-[7%] rounded-t-md bg-violet/35"></div>
                                        <div class="h-[85%] w-[7%] rounded-t-md bg-cyan/40"></div>
                                    </div>
                                </div>
                                <div class="flex justify-around gap-3 pt-4 text-sm text-muted" aria-hidden="true">
                                    <span>T2</span>
                                    <span>T3</span>
                                    <span>T4</span>
                                    <span>T5</span>
                                    <span>T6</span>
                                    <span>T7</span>
                                    <span>CN</span>
                                </div>
                            </div>
                        </section>

                        <section class="glass-card rounded-2xl border border-navy/10 p-6 shadow-sm sm:p-8">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <h3 class="text-2xl font-bold text-navy">Ngành được quan tâm</h3>
                                    <p class="mt-1 text-sm text-muted">Phân bổ từ các kết quả tư vấn</p>
                                </div>
                                <span class="mt-1 whitespace-nowrap text-sm font-bold text-ocean">Chi tiết ↗</span>
                            </div>
                            <ol data-export-majors class="mt-8">
                                <li class="flex items-center gap-4 border-b border-navy/10 py-5 first:pt-2">
                                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-cyan/10 font-bold text-ocean">01</span>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-bold text-navy">Công nghệ thông tin</p>
                                        <p class="mt-1 text-sm text-muted">32% lượt gợi ý</p>
                                    </div>
                                    <span class="text-xl font-bold text-ocean">32%</span>
                                </li>
                                <li class="flex items-center gap-4 border-b border-navy/10 py-5">
                                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-violet/10 font-bold text-violet">02</span>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-bold text-navy">Thiết kế đồ họa</p>
                                        <p class="mt-1 text-sm text-muted">24% lượt gợi ý</p>
                                    </div>
                                    <span class="text-xl font-bold text-ocean">24%</span>
                                </li>
                                <li class="flex items-center gap-4 py-5">
                                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ocean/10 font-bold text-ocean">03</span>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-bold text-navy">Quản trị kinh doanh</p>
                                        <p class="mt-1 text-sm text-muted">18% lượt gợi ý</p>
                                    </div>
                                    <span class="text-xl font-bold text-ocean">18%</span>
                                </li>
                            </ol>
                        </section>
                    </div>

                </section>

                <section id="accounts" class="admin-panel hidden">
                    <div class="glass-card rounded-3xl border border-navy/5 p-5 shadow-lg">
                        <div class="mb-4 flex items-center justify-between">
                            <h3 class="text-3xl font-black text-navy">Quản lý tài khoản người dùng</h3>
                            <button id="export-accounts" type="button" class="inline-flex items-center gap-2 rounded-2xl border border-cyan/20 bg-cyan/10 px-4 py-2.5 text-sm font-bold text-cyan transition hover:bg-cyan/15">
                                <i data-lucide="download" class="h-4 w-4"></i>
                                Xuất Excel
                            </button>
                        </div>

                        <div class="overflow-x-auto rounded-2xl border border-navy/10 bg-white/70">
                            <table class="min-w-full text-left text-sm text-navy">
                                <thead class="bg-slate-50 text-xs uppercase tracking-[0.12em] text-muted">
                                    <tr>
                                        <th class="px-4 py-3 font-bold">Tên</th>
                                        <th class="px-4 py-3 font-bold">Email</th>
                                        <th class="px-4 py-3 font-bold">Vai trò</th>
                                        <th class="px-4 py-3 font-bold">Trạng thái</th>
                                        <th class="px-4 py-3 font-bold text-right">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="border-t border-navy/5">
                                        <td class="px-4 py-3 font-semibold">Đoàn Nguyễn Gia Hưng</td>
                                        <td class="px-4 py-3">giahung@gmail.com</td>
                                        <td class="px-4 py-3"><span class="rounded-full bg-cyan/10 px-2 py-1 text-[11px] font-bold text-cyan">Người dùng</span></td>
                                        <td class="px-4 py-3"><span class="rounded-full bg-emerald-100 px-2 py-1 text-[11px] font-bold text-emerald-700">Hoạt động</span></td>
                                        <td class="px-4 py-3 text-right space-x-2">
                                            <button type="button" class="rounded-xl border border-cyan/30 bg-cyan/5 px-2.5 py-1.5 text-[11px] font-bold text-cyan">Đặt lại mật khẩu</button>
                                            <button type="button" class="rounded-xl border border-red-200 bg-red-50 px-2.5 py-1.5 text-[11px] font-bold text-red-600">Khóa tài khoản</button>
                                        </td>
                                    </tr>
                                    <tr class="border-t border-navy/5">
                                        <td class="px-4 py-3 font-semibold">Văn Minh Thanh Thiệu</td>
                                        <td class="px-4 py-3">thanhthieu@gmail.com</td>
                                        <td class="px-4 py-3"><span class="rounded-full bg-cyan/10 px-2 py-1 text-[11px] font-bold text-cyan">Người dùng</span></td>
                                        <td class="px-4 py-3"><span class="rounded-full bg-emerald-100 px-2 py-1 text-[11px] font-bold text-emerald-700">Hoạt động</span></td>
                                        <td class="px-4 py-3 text-right space-x-2">
                                            <button type="button" class="rounded-xl border border-cyan/30 bg-cyan/5 px-2.5 py-1.5 text-[11px] font-bold text-cyan">Đặt lại mật khẩu</button>
                                            <button type="button" class="rounded-xl border border-red-200 bg-red-50 px-2.5 py-1.5 text-[11px] font-bold text-red-600">Khóa tài khoản</button>
                                        </td>
                                    </tr>
                                    <tr class="border-t border-navy/5">
                                        <td class="px-4 py-3 font-semibold">Cao Thị Thanh Ngân</td>
                                        <td class="px-4 py-3">thanhngan@gmail.com</td>
                                        <td class="px-4 py-3"><span class="rounded-full bg-cyan/10 px-2 py-1 text-[11px] font-bold text-cyan">Người dùng</span></td>
                                        <td class="px-4 py-3"><span class="rounded-full bg-emerald-100 px-2 py-1 text-[11px] font-bold text-emerald-700">Hoạt động</span></td>
                                        <td class="px-4 py-3 text-right space-x-2">
                                            <button type="button" class="rounded-xl border border-cyan/30 bg-cyan/5 px-2.5 py-1.5 text-[11px] font-bold text-cyan">Đặt lại mật khẩu</button>
                                            <button type="button" class="rounded-xl border border-red-200 bg-red-50 px-2.5 py-1.5 text-[11px] font-bold text-red-600">Khóa tài khoản</button>
                                        </td>
                                    </tr>
                                    <tr class="border-t border-navy/5">
                                        <td class="px-4 py-3 font-semibold">Nguyễn Nhất Nguyên</td>
                                        <td class="px-4 py-3">nhatnguyen@gmail.com</td>
                                        <td class="px-4 py-3"><span class="rounded-full bg-cyan/10 px-2 py-1 text-[11px] font-bold text-cyan">Người dùng</span></td>
                                        <td class="px-4 py-3"><span class="rounded-full bg-emerald-100 px-2 py-1 text-[11px] font-bold text-emerald-700">Hoạt động</span></td>
                                        <td class="px-4 py-3 text-right space-x-2">
                                            <button type="button" class="rounded-xl border border-cyan/30 bg-cyan/5 px-2.5 py-1.5 text-[11px] font-bold text-cyan">Đặt lại mật khẩu</button>
                                            <button type="button" class="rounded-xl border border-red-200 bg-red-50 px-2.5 py-1.5 text-[11px] font-bold text-red-600">Khóa tài khoản</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section id="news" class="admin-panel hidden">
                    <div class="glass-card rounded-3xl border border-navy/5 p-5 shadow-lg">
                        <div class="mb-4 flex items-center justify-between">
                            <h3 class="text-3xl font-black text-navy">Quản lý tin tức</h3>
                            <button type="button" class="rounded-2xl bg-cyan/10 px-4 py-2.5 text-sm font-bold text-cyan border border-cyan/20">+ Tạo bài viết</button>
                        </div>

                        <% const managedNews = [
                            { title: 'Thế Hệ Gen Z & Nguy Cơ Lỗi Thời: Top 5 Kỹ Năng Số Cần Chuẩn Bị Cho Kỷ Nguyên AI 2027', category: 'Xu hướng nghề & AI · Bài nổi bật', date: '01/10/2026' },
                            { title: 'Phương Pháp 3 Chiều Chọn Ngành: Sở Thích, Điểm Thi & Mức Thu Nhập Thực Tế', category: 'Cẩm nang chọn ngành · Bài nổi bật', date: 'Bài nổi bật' },
                            { title: 'Sinh Viên IT Năm 3 Review Thẳng Thắn: Học Công Nghệ Thông Tin Có Màu Hồng Như Lời Đồn?', category: 'Góc sinh viên · Bài nổi bật', date: 'Bài nổi bật' },
                            { title: 'Học Kỹ Thuật Phần Mềm Năm 2026: Cần Trình Độ Tiếng Anh & Thuật Toán Như Thế Nào?', category: 'Xu hướng nghề & AI', date: '30/09/2026' },
                            { title: 'Bí Quyết Phân Bổ Nguyện Vọng Đại Học 2026: Tránh Rủi Ro Bằng Chiến Lược Bậc Thang', category: 'Thông tin tuyển sinh', date: '27/09/2026' }
                        ]; %>
                        <div class="space-y-4">
                            <% managedNews.forEach((article) => { %>
                                <article class="rounded-2xl border border-navy/10 bg-slate-50 p-4">
                                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                        <div class="min-w-0">
                                            <div class="mb-2 flex flex-wrap items-center gap-2">
                                                <span class="rounded-full bg-cyan/10 px-2.5 py-1 text-[11px] font-bold text-cyan"><%= article.category %></span>
                                                <span class="text-xs text-muted"><%= article.date %></span>
                                            </div>
                                            <p class="text-base font-bold leading-relaxed text-navy"><%= article.title %></p>
                                        </div>
                                        <span class="w-fit shrink-0 rounded-full bg-emerald-100 px-2.5 py-1 text-[11px] font-bold text-emerald-700">Hiện</span>
                                    </div>
                                    <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
                                        <button type="button" class="rounded-xl border border-cyan/30 bg-cyan/5 px-3 py-1.5 text-xs font-bold text-cyan">Chỉnh sửa</button>
                                        <button type="button" class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-700">Ẩn bài viết</button>
                                        <button type="button" class="rounded-xl border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-bold text-red-600">Xóa</button>
                                    </div>
                                </article>
                            <% }); %>
                        </div>
                    </div>
                </section>
        </div>
    </main>
</div>

<%- include('../partials/footer', { extraScripts: '<script src="/js/admin.js"></script>' }) %>
