<%- include('../partials/header') %>

<!-- KHU VỰC NỘI DUNG CHÍNH (CĂN GIỮA MÀN HÌNH) -->
<div id="main-wrapper" class="transition-all duration-300 w-full min-h-screen flex flex-col items-center relative pt-20 pb-20 px-4 sm:px-8">
    <main class="w-full max-w-6xl relative flex flex-col">
        
        <!-- TIÊU ĐỀ TRANG & MÔ TẢ -->
        <div class="mb-8 text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan/10 border border-cyan/20 text-cyan text-xs font-bold mb-2">
                <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Góc Nhìn Tuyển Sinh & Thị Trường Lao Động 2026
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-navy tracking-tight">
                Cẩm Nang Định Hướng & <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan to-violet">Tin Tức Nghề Nghiệp</span>
            </h1>
            <p class="text-sm text-muted mt-2 max-w-2xl leading-relaxed">
                Cập nhật xu hướng việc làm thời đại chuyển đổi số, giải mã biến động điểm chuẩn và nhận lời khuyên từ chuyên gia để định vị chính xác ngành học tương lai của bạn.
            </p>
        </div>

        <!-- ================= 1. THANH TÌM KIẾM & BỘ LỌC THÔNG MINH ================= -->
        <section class="glass-card rounded-3xl p-5 mb-10 border border-navy/5 shadow-sm space-y-4">
            
            <!-- Hàng trên: Thanh tìm kiếm & Dropdown nâng cao -->
            <div class="flex flex-col md:flex-row items-center gap-3">
                <div class="relative flex-1 w-full">
                    <i data-lucide="search" class="absolute left-4 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted"></i>
                    <input type="text" id="news-search-input" oninput="handleSearchAndFilter()" 
                        placeholder="Tìm kiếm: 'Điểm chuẩn 2027', 'Học phí CNTT', 'Kinh tế số'..." 
                        class="w-full pl-11 pr-4 py-2.5 rounded-2xl bg-gray-50/80 border border-gray-200 text-sm outline-none focus:border-cyan focus:bg-white transition-all text-navy placeholder:text-muted">
                </div>

                <!-- Lọc theo Khối thi -->
                <select id="filter-block" onchange="handleSearchAndFilter()" class="w-full md:w-44 px-3.5 py-2.5 rounded-2xl bg-gray-50 border border-gray-200 text-xs font-bold text-navy outline-none cursor-pointer">
                    <option value="all">Khối thi: Tất cả</option>
                    <option value="A00">Khối A00 (Toán, Lý, Hóa)</option>
                    <option value="A01">Khối A01 (Toán, Lý, Anh)</option>
                    <option value="D01">Khối D01 (Toán, Văn, Anh)</option>
                    <option value="D07">Khối D07 (Toán, Hóa, Anh)</option>
                    <option value="B00">Khối B00 (Toán, Hóa, Sinh)</option>
                </select>

                <!-- Lọc theo Nhóm ngành -->
                <select id="filter-industry" onchange="handleSearchAndFilter()" class="w-full md:w-48 px-3.5 py-2.5 rounded-2xl bg-gray-50 border border-gray-200 text-xs font-bold text-navy outline-none cursor-pointer">
                    <option value="all">Nhóm ngành: Tất cả</option>
                    <option value="tech">Công nghệ thông tin & AI</option>
                    <option value="business">Kinh tế, Marketing & QTKD</option>
                    <option value="medical">Y - Dược & Sức khỏe</option>
                    <option value="design">Thiết kế, Mỹ thuật số & Art</option>
                    <option value="language">Ngôn ngữ & Truyền thông</option>
                </select>
            </div>

            <!-- Hàng dưới: Thanh danh mục / Thẻ chủ đề (Tabs cuộn ngang linh hoạt) -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 pt-1 no-scrollbar text-xs font-semibold" id="category-tabs-container">
                <button onclick="selectCategory('all', this)" class="cat-pill active px-4 py-2 rounded-xl bg-cyan text-white shadow-sm whitespace-nowrap transition-all font-bold">Tất cả bài viết</button>
                <button onclick="selectCategory('trend', this)" class="cat-pill px-4 py-2 rounded-xl bg-white border border-gray-200 text-muted hover:text-cyan hover:border-cyan whitespace-nowrap transition-all">🚀 Xu hướng nghề & AI</button>
                <button onclick="selectCategory('guide', this)" class="cat-pill px-4 py-2 rounded-xl bg-white border border-gray-200 text-muted hover:text-cyan hover:border-cyan whitespace-nowrap transition-all">📘 Cẩm nang chọn ngành</button>
                <button onclick="selectCategory('admission', this)" class="cat-pill px-4 py-2 rounded-xl bg-white border border-gray-200 text-muted hover:text-cyan hover:border-cyan whitespace-nowrap transition-all">🎯 Thông tin tuyển sinh</button>
                <button onclick="selectCategory('review', this)" class="cat-pill px-4 py-2 rounded-xl bg-white border border-gray-200 text-muted hover:text-cyan hover:border-cyan whitespace-nowrap transition-all">🎓 Review ngành học</button>
                <button onclick="selectCategory('expert', this)" class="cat-pill px-4 py-2 rounded-xl bg-white border border-gray-200 text-muted hover:text-cyan hover:border-cyan whitespace-nowrap transition-all">💡 Góc chuyên gia</button>
            </div>
        </section>

        <!-- ================= 2. KHỐI BÀI VIẾT NỔI BẬT (HERO / FEATURED BENTO GRID) ================= -->
        <section class="mb-14">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-black text-navy flex items-center gap-2">
                    <i data-lucide="flame" class="w-5 h-5 text-red-500"></i> Bài Viết Nổi Bật Tuần Này
                </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Bài chính khổ lớn bên trái (7 cột) -->
                <div class="lg:col-span-7 glass-card rounded-3xl overflow-hidden hover:shadow-xl transition-all duration-300 border border-navy/5 group cursor-pointer flex flex-col justify-between" onclick="openArticleModal('hero-1')">
                    <div class="relative h-64 sm:h-72 w-full overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=1200&q=80" alt="AI & Việc làm 2026" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/30 to-transparent"></div>
                        <span class="absolute top-4 left-4 bg-red-500 text-white text-[11px] font-black uppercase px-3 py-1 rounded-full shadow-md flex items-center gap-1">
                            <i data-lucide="zap" class="w-3 h-3"></i> HOT 2026
                        </span>
                        <div class="absolute bottom-4 left-4 right-4 text-white">
                            <span class="text-xs font-bold text-cyan uppercase tracking-wider">Xu hướng nghề & AI</span>
                            <h3 class="text-xl sm:text-2xl font-black mt-1 leading-snug group-hover:text-cyan transition-colors">
                                Thế Hệ Gen Z & Nguy Cơ Lỗi Thời: Top 5 Kỹ Năng Số Cần Chuẩn Bị Cho Kỷ Nguyên AI 2027
                            </h3>
                        </div>
                    </div>
                    <div class="p-6 bg-white/95 flex-1 flex flex-col justify-between">
                        <p class="text-xs sm:text-sm text-muted line-clamp-2 leading-relaxed">
                            Trí tuệ nhân tạo đang tái định hình cách thức vận hành của các ngành lập trình, marketing và thiết kế. Sinh viên cần rèn luyện năng lực thích ứng nào để làm chủ công nghệ thay vì bị thay thế?
                        </p>
                        <div class="flex items-center justify-between text-xs text-muted pt-4 mt-4 border-t border-gray-100">
                            <span class="font-bold text-navy">Ban Cố Vấn Laban.ai</span>
                            <div class="flex items-center gap-3">
                                <span>01/10/2026</span>
                                <span>•</span>
                                <span class="flex items-center gap-1"><i data-lucide="clock" class="w-3.5 h-3.5 text-cyan"></i> 6 phút đọc</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2 Bài viết phụ bên phải (5 cột) -->
                <div class="lg:col-span-5 flex flex-col gap-6">
                    <!-- Card phụ 1 -->
                    <div class="glass-card rounded-3xl p-5 hover:shadow-lg transition-all duration-300 border border-navy/5 group cursor-pointer flex gap-4 bg-white/90" onclick="openArticleModal('hero-2')">
                        <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden shrink-0 relative">
                            <img src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=500&q=80" alt="Điểm chuẩn 2026" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                            <span class="absolute top-2 left-2 bg-emerald text-white text-[9px] font-extrabold px-2 py-0.5 rounded-md">Tuyển sinh 2026</span>
                        </div>
                        <div class="flex-1 flex flex-col justify-between">
                            <div>
                                <span class="text-[10px] font-bold text-violet uppercase">Cẩm nang chọn ngành</span>
                                <h4 class="font-bold text-sm text-navy line-clamp-2 mt-1 group-hover:text-cyan transition-colors leading-snug">
                                    Phương Pháp 3 Chiều Chọn Ngành: Sở Thích, Điểm Thi & Mức Thu Nhập Thực Tế
                                </h4>
                            </div>
                            <div class="text-[11px] text-muted flex items-center justify-between mt-2 pt-2 border-t border-gray-100">
                                <span>5 phút đọc</span>
                                <span class="text-cyan font-bold flex items-center gap-0.5">Đọc tiếp <i data-lucide="chevron-right" class="w-3 h-3"></i></span>
                            </div>
                        </div>
                    </div>

                    <!-- Card phụ 2 -->
                    <div class="glass-card rounded-3xl p-5 hover:shadow-lg transition-all duration-300 border border-navy/5 group cursor-pointer flex gap-4 bg-white/90" onclick="openArticleModal('hero-3')">
                        <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden shrink-0 relative">
                            <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=500&q=80" alt="Sinh viên review" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                            <span class="absolute top-2 left-2 bg-cyan text-white text-[9px] font-extrabold px-2 py-0.5 rounded-md">Review Thực Tế</span>
                        </div>
                        <div class="flex-1 flex flex-col justify-between">
                            <div>
                                <span class="text-[10px] font-bold text-cyan uppercase">Góc sinh viên</span>
                                <h4 class="font-bold text-sm text-navy line-clamp-2 mt-1 group-hover:text-cyan transition-colors leading-snug">
                                    Sinh Viên IT Năm 3 Review Thẳng Thắn: Học Công Nghệ Thông Tin Có Màu Hồng Như Lời Đồn?
                                </h4>
                            </div>
                            <div class="text-[11px] text-muted flex items-center justify-between mt-2 pt-2 border-t border-gray-100">
                                <span>7 phút đọc</span>
                                <span class="text-cyan font-bold flex items-center gap-0.5">Đọc tiếp <i data-lucide="chevron-right" class="w-3 h-3"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= 3 & 4. DANH SÁCH BÀI VIẾT CHÍNH + SIDEBAR AI WIDGET ================= -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
            
            <!-- CỘT TRÁI (8 CỘT): FEED BÀI VIẾT CHÍNH -->
            <div class="lg:col-span-8 space-y-6">
                
                <!-- Thanh sắp xếp bài viết -->
                <div class="flex justify-between items-center pb-3 border-b border-gray-200 text-xs">
                    <span class="text-muted">Hiển thị <b id="news-count" class="text-navy">6</b> bài viết liên quan</span>
                    <div class="flex items-center gap-2">
                        <span class="text-muted font-medium">Sắp xếp theo:</span>
                        <select id="news-sort-select" onchange="handleSearchAndFilter()" class="bg-transparent font-bold text-cyan outline-none cursor-pointer">
                            <option value="newest">Mới nhất</option>
                            <option value="views">Xem nhiều nhất</option>
                            <option value="likes">Được quan tâm nhất</option>
                        </select>
                    </div>
                </div>

                <!-- Lưới Thẻ Bài Viết (Card Feed) -->
                <div id="articles-feed-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <!-- JS nạp động các Card bài viết với nút tim/bỏ tim -->
                </div>

                <!-- Nút tải thêm -->
                <div class="pt-6 text-center">
                    <button id="btn-load-more" onclick="loadMoreArticles()" class="px-8 py-3 rounded-2xl glass-card bg-white border border-slate-200 hover:border-cyan text-navy hover:text-cyan font-bold text-xs shadow-sm transition-all flex items-center gap-2 mx-auto active:scale-95">
                        <i data-lucide="refresh-cw" class="w-4 h-4"></i> Xem thêm bài viết khác
                    </button>
                </div>
            </div>

            <!-- CỘT PHẢI (4 CỘT): SIDEBAR KẾT NỐI HỆ THỐNG AI & TRENDING -->
            <aside class="lg:col-span-4 space-y-6">
                
                <!-- WIDGET 1: CTA TƯ VẤN AI NHANH -->
                <div class="glass-card rounded-3xl p-6 bg-gradient-to-br from-cyan/15 via-violet/10 to-surface border border-cyan/30 shadow-lg relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-cyan/15 rounded-full blur-2xl -z-10 group-hover:scale-125 transition-transform duration-500"></div>
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan to-violet flex items-center justify-center text-white shadow-md mb-4">
                        <i data-lucide="compass" class="w-6 h-6 stroke-[2.2]"></i>
                    </div>
                    <h3 class="text-lg font-black text-navy leading-snug mb-2">
                        Bạn vẫn chưa biết mình hợp với ngành nào?
                    </h3>
                    <p class="text-xs text-muted mb-5 leading-relaxed">
                        Để mô hình AI của Laban phân tích sở thích Holland và đối chiếu điểm số với phổ điểm đại học 2026 chỉ trong 3 phút.
                    </p>
                    <button onclick="handleStartAction()" class="w-full py-3 rounded-2xl btn-gradient text-white font-bold text-xs shadow-md hover-glow flex items-center justify-center gap-2 transition-all active:scale-95">
                        <i data-lucide="target" class="w-4 h-4"></i> Khảo sát định hướng ngay
                    </button>
                    <button onclick="handleChatbotAction()" class="w-full mt-2.5 py-2.5 rounded-2xl bg-white border border-cyan/20 hover:border-cyan text-navy hover:text-cyan font-bold text-xs flex items-center justify-center gap-2 transition-all">
                        <i data-lucide="message-square" class="w-4 h-4 text-violet"></i> Trò chuyện cùng ChatBot AI
                    </button>
                </div>

                <!-- WIDGET 2: CHỦ ĐỀ ĐANG TRENDING -->
                <div class="glass-card rounded-3xl p-6 bg-white/90 border border-navy/5 shadow-sm">
                    <h4 class="font-black text-sm text-navy mb-4 flex items-center gap-2">
                        <i data-lucide="trending-up" class="w-4 h-4 text-cyan"></i> Chủ Đề Đang Được Quan Tâm
                    </h4>
                    <div class="flex flex-wrap gap-2 text-xs">
                        <span onclick="searchByTag('Học phí CNTT')" class="px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200 hover:border-cyan hover:text-cyan text-muted font-medium cursor-pointer transition-all">#Học phí CNTT</span>
                        <span onclick="searchByTag('Điểm chuẩn 2026')" class="px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200 hover:border-cyan hover:text-cyan text-muted font-medium cursor-pointer transition-all">#Điểm chuẩn 2026</span>
                        <span onclick="searchByTag('Holland RIASEC')" class="px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200 hover:border-cyan hover:text-cyan text-muted font-medium cursor-pointer transition-all">#Holland RIASEC</span>
                        <span onclick="searchByTag('Khối D01')" class="px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200 hover:border-cyan hover:text-cyan text-muted font-medium cursor-pointer transition-all">#Khối D01</span>
                        <span onclick="searchByTag('Trí tuệ nhân tạo')" class="px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200 hover:border-cyan hover:text-cyan text-muted font-medium cursor-pointer transition-all">#Trí tuệ nhân tạo</span>
                        <span onclick="searchByTag('Học bổng')" class="px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200 hover:border-cyan hover:text-cyan text-muted font-medium cursor-pointer transition-all">#Học bổng</span>
                    </div>
                </div>

                <!-- WIDGET 3: LỌC NHANH THEO NHÓM NGÀNH SHORTCUT -->
                <div class="glass-card rounded-3xl p-6 bg-white/90 border border-navy/5 shadow-sm">
                    <h4 class="font-black text-sm text-navy mb-3 flex items-center gap-2">
                        <i data-lucide="layers" class="w-4 h-4 text-violet"></i> Nhóm Ngành Trọng Điểm
                    </h4>
                    <div class="space-y-2 text-xs font-semibold">
                        <div onclick="filterByIndustryShortcut('tech')" class="flex justify-between items-center p-2.5 rounded-xl hover:bg-cyan/5 hover:text-cyan cursor-pointer transition-all">
                            <span>Công nghệ thông tin & AI</span>
                            <span class="text-muted font-normal bg-gray-100 px-2 py-0.5 rounded-md">14 bài</span>
                        </div>
                        <div onclick="filterByIndustryShortcut('business')" class="flex justify-between items-center p-2.5 rounded-xl hover:bg-cyan/5 hover:text-cyan cursor-pointer transition-all">
                            <span>Kinh tế & Marketing số</span>
                            <span class="text-muted font-normal bg-gray-100 px-2 py-0.5 rounded-md">9 bài</span>
                        </div>
                        <div onclick="filterByIndustryShortcut('medical')" class="flex justify-between items-center p-2.5 rounded-xl hover:bg-cyan/5 hover:text-cyan cursor-pointer transition-all">
                            <span>Y - Dược & Y tế công cộng</span>
                            <span class="text-muted font-normal bg-gray-100 px-2 py-0.5 rounded-md">6 bài</span>
                        </div>
                        <div onclick="filterByIndustryShortcut('design')" class="flex justify-between items-center p-2.5 rounded-xl hover:bg-cyan/5 hover:text-cyan cursor-pointer transition-all">
                            <span>Thiết kế mỹ thuật đa phương tiện</span>
                            <span class="text-muted font-normal bg-gray-100 px-2 py-0.5 rounded-md">8 bài</span>
                        </div>
                    </div>
                </div>

            </aside>
        </div>
    </main>
</div>

<!-- ================= MODAL XEM CHI TIẾT BÀI VIẾT (CHỈ CÓ NÚT SAO CHÉP LIÊN KẾT HOẠT ĐỘNG THẬT) ================= -->
<div id="article-detail-modal" class="fixed inset-0 z-[120] hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-navy/70 backdrop-blur-md" onclick="closeArticleModal()"></div>
    <div class="bg-surface rounded-3xl shadow-2xl z-10 w-full max-w-3xl max-h-[90vh] flex flex-col overflow-hidden relative transform scale-95 opacity-0 transition-all duration-300" id="article-modal-box">
        
        <!-- Header Modal -->
        <div class="px-8 py-4 border-b border-gray-100 flex justify-between items-center bg-cyan/5">
            <span id="modal-category-badge" class="text-xs font-black text-cyan uppercase tracking-wider bg-cyan/10 px-3 py-1 rounded-md">XU HƯỚNG NGHỀ & AI</span>
            <button onclick="closeArticleModal()" class="w-9 h-9 rounded-full bg-white text-muted hover:text-red-500 flex items-center justify-center shadow-sm transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <!-- Nội dung bài viết cuộn được -->
        <div class="flex-1 overflow-y-auto p-6 sm:p-8 space-y-6">
            <div>
                <h2 id="modal-title" class="text-xl sm:text-2xl font-black text-navy leading-snug">Tiêu đề bài viết</h2>
                <div class="flex items-center gap-4 text-xs text-muted mt-2 pt-2 border-t border-gray-100">
                    <span>Tác giả: <b id="modal-author" class="text-navy">Laban.ai Editorial</b></span>
                    <span>•</span>
                    <span id="modal-date">01/10/2026</span>
                    <span>•</span>
                    <span id="modal-read-time">5 phút đọc</span>
                </div>
            </div>

            <div class="rounded-2xl overflow-hidden max-h-72 w-full">
                <img id="modal-image" src="" alt="Thumbnail" class="w-full h-full object-cover">
            </div>

            <div id="modal-content" class="text-sm leading-relaxed text-navy/90 space-y-4 text-justify">
                <!-- Nội dung đoạn văn được nạp động -->
            </div>

            <!-- CTA Đo độ phù hợp ngành bằng AI ngay cuối bài -->
            <div class="p-6 rounded-2xl bg-gradient-to-r from-cyan/10 to-violet/10 border border-cyan/30 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div>
                    <h4 class="font-black text-navy text-sm">Bạn cảm thấy hứng thú với ngành học này?</h4>
                    <p class="text-xs text-muted mt-0.5">Sử dụng AI để đối chiếu năng lực học tập và tính cách của bạn với tiêu chuẩn ngành.</p>
                </div>
                <!-- Sửa lại link gọi hàm để tương thích MVC -->
                <button id="modal-btn-ai-analyze" onclick="window.location.href='/evaluation'" class="btn-gradient px-6 py-2.5 rounded-xl text-white font-bold text-xs shadow hover-glow shrink-0 flex items-center gap-1.5 transition-all">
                    <i data-lucide="brain" class="w-4 h-4"></i> Phân tích độ phù hợp với ngành
                </button>
            </div>
        </div>

        <!-- Footer Modal: CHỈ GIỮ NÚT SAO CHÉP LIÊN KẾT BÀI VIẾT (CHẠY 100% THỰC TẾ) -->
