<%- include('../partials/header', { 
    extraHead: `<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>` 
}) %>

<div id="main-wrapper" class="transition-all duration-300 w-full min-h-screen flex flex-col items-center relative pt-16 pb-28 px-4 sm:px-8">
    <div class="fixed top-[-10%] right-[-5%] w-[400px] h-[400px] bg-cyan/10 rounded-full blur-[100px] -z-10"></div>
    <div class="fixed bottom-[-10%] left-[20%] w-[500px] h-[500px] bg-violet/10 rounded-full blur-[120px] -z-10"></div>

    <main class="w-full max-w-5xl relative flex flex-col pt-8">
        <div class="mb-6 text-left">
            <h2 id="page-heading" class="text-2xl font-black text-navy tracking-tight">Đánh giá Năng lực & Định hướng</h2>
            <p id="page-subheading" class="text-sm text-muted mt-1">Khảo sát năng lực học tập và khám phá nghề nghiệp theo chuẩn Holland RIASEC.</p>
        </div>

        <!-- PHÂN HỆ 1: FORM -->
        <div id="assessment-container" class="flex-1 flex flex-col w-full">
            <div class="w-full max-w-3xl mx-auto mb-10 mt-2">
                <div class="flex items-center justify-between relative before:absolute before:top-1/2 before:left-0 before:w-full before:h-1 before:bg-gray-200 before:-z-10 before:-translate-y-1/2">
                    <div id="progress-line" class="absolute top-1/2 left-0 h-1 bg-cyan -z-10 -translate-y-1/2 transition-all duration-500 w-0"></div>
                    <div class="step flex flex-col items-center gap-2" id="indicator-step-1"><div class="w-8 h-8 rounded-full bg-cyan text-white flex items-center justify-center font-bold shadow-md">1</div><span class="text-xs font-bold text-navy">Hồ sơ học tập</span></div>
                    <div class="step flex flex-col items-center gap-2" id="indicator-step-2"><div class="w-8 h-8 rounded-full bg-gray-200 text-gray-400 flex items-center justify-center font-bold shadow-md">2</div><span class="text-xs font-semibold text-gray-400">Trắc nghiệm Holland</span></div>
                    <div class="step flex flex-col items-center gap-2" id="indicator-step-3"><div class="w-8 h-8 rounded-full bg-gray-200 text-gray-400 flex items-center justify-center font-bold shadow-md">3</div><span class="text-xs font-semibold text-gray-400">Kết quả AI</span></div>
                </div>
            </div>

            <!-- BƯỚC 1 -->
            <section id="step-1" class="step-content transition-all duration-500">
                <div class="glass-card rounded-3xl p-8 mb-6">
                    <h3 class="text-xl font-bold text-navy mb-2 flex items-center gap-2"><i data-lucide="graduation-cap" class="text-cyan"></i> Điểm số học tập dự kiến</h3>
                    <p class="text-sm text-muted mb-6">Nhập điểm trung bình các môn để hệ thống tính toán khối thi và năng lực học thuật.</p>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-5">
                        <div><label class="text-xs font-bold text-muted block mb-1">Toán</label><input type="number" step="0.1" id="input-toan" value="8.5" class="input-field eval-input" placeholder="8.5"></div>
                        <div><label class="text-xs font-bold text-muted block mb-1">Ngữ Văn</label><input type="number" step="0.1" id="input-van" value="7.0" class="input-field eval-input" placeholder="7.0"></div>
                        <div><label class="text-xs font-bold text-muted block mb-1">Tiếng Anh</label><input type="number" step="0.1" id="input-anh" value="9.0" class="input-field eval-input" placeholder="9.0"></div>
                        <div><label class="text-xs font-bold text-muted block mb-1">Vật Lý</label><input type="number" step="0.1" id="input-ly" value="8.0" class="input-field eval-input" placeholder="8.0"></div>
                        <div><label class="text-xs font-bold text-muted block mb-1">Hóa Học</label><input type="number" step="0.1" id="input-hoa" value="7.5" class="input-field eval-input" placeholder="7.5"></div>
                        <div><label class="text-xs font-bold text-muted block mb-1">Sinh Học</label><input type="number" step="0.1" id="input-sinh" value="6.5" class="input-field eval-input" placeholder="6.5"></div>
                        <div><label class="text-xs font-bold text-muted block mb-1">Lịch Sử</label><input type="number" step="0.1" id="input-su" value="7.0" class="input-field eval-input" placeholder="7.0"></div>
                        <div><label class="text-xs font-bold text-muted block mb-1">Địa Lý</label><input type="number" step="0.1" id="input-dia" value="7.5" class="input-field eval-input" placeholder="7.5"></div>
                        <div><label class="text-xs font-bold text-muted block mb-1">Tin Học / GDCD</label><input type="number" step="0.1" id="input-tin" value="9.0" class="input-field eval-input" placeholder="9.0"></div>
                    </div>
                </div>
            </section>

            <!-- BƯỚC 2 -->
            <section id="step-2" class="step-content hidden transition-all duration-500">
                <div class="glass-card rounded-3xl p-8 mb-6">
                    <div class="flex justify-between items-end mb-6 border-b border-gray-100 pb-4">
                        <div>
                            <h3 class="text-xl font-bold text-navy flex items-center gap-2"><i data-lucide="brain" class="text-cyan"></i> Đánh giá Sở thích Nghề nghiệp (Holland RIASEC)</h3>
                            <p class="text-sm text-muted mt-1">Đánh giá theo thang đo từ 1 (Rất không thích) đến 5 (Rất thích).</p>
                        </div>
                        <div class="text-sm font-bold text-cyan bg-cyan/10 px-4 py-2 rounded-xl"><span id="q-progress">0</span> / 60</div>
                    </div>
                    <div id="questions-container" class="space-y-4"></div>
                </div>
            </section>

            <!-- BƯỚC 3 -->
            <section id="step-3" class="step-content hidden transition-all duration-500">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
                    <div class="lg:col-span-5 glass-card rounded-3xl p-8 flex flex-col items-center justify-center">
                        <h3 class="font-bold text-xl text-navy mb-4 text-center">Hồ sơ năng lực (Holland)</h3>
                        <div class="w-full max-w-[340px] h-[340px] relative"><canvas id="riasecChart"></canvas></div>
                        <div id="holland-result-code" class="mt-4 text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan to-violet">ISR</div>
                        <p class="text-xs text-muted font-semibold mt-1">Mã Holland đại diện cho tính cách nổi trội</p>
                    </div>
                    <div class="lg:col-span-7 space-y-6">
                        <div class="glass-card rounded-3xl p-8 bg-gradient-to-br from-cyan/5 to-violet/5 border-cyan/20">
                            <h4 class="font-bold text-lg text-navy mb-3 flex items-center gap-2"><i data-lucide="bot" class="text-cyan"></i> AI Phân tích chi tiết</h4>
                            <p class="text-sm text-navy/80 leading-relaxed text-justify">Mô hình AI nhận diện hồ sơ của bạn nổi trội ở nhóm <strong>Investigative (Nghiên cứu)</strong> kết hợp <strong>Social (Xã hội)</strong>. Điểm số các môn Tự nhiên đạt mức tốt, phù hợp nhất với các khối ngành ứng dụng kỹ thuật và khoa học dữ liệu.</p>
                        </div>
                        <div class="glass-card rounded-3xl p-8">
                            <h4 class="font-bold text-lg text-navy mb-4">Top Ngành đề xuất phù hợp nhất</h4>
                            <div class="space-y-3">
                                <div class="p-4 rounded-2xl bg-white border border-gray-100 flex items-center justify-between shadow-sm">
                                    <div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-emerald/10 text-emerald flex items-center justify-center font-bold">1</div><div><div class="font-bold text-navy">Công nghệ thông tin</div><div class="text-xs text-muted">Kỹ thuật phần mềm & AI</div></div></div><div class="text-lg font-black text-emerald">89%</div>
                                </div>
                                <div class="p-4 rounded-2xl bg-white border border-gray-100 flex items-center justify-between shadow-sm">
                                    <div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-cyan/10 text-cyan flex items-center justify-center font-bold">2</div><div><div class="font-bold text-navy">Khoa học Dữ liệu</div><div class="text-xs text-muted">Toán tin ứng dụng</div></div></div><div class="text-lg font-black text-cyan">85%</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- ================= PHÂN HỆ 2: GIAO DIỆN LỊCH SỬ (ẨN MẶC ĐỊNH) ================= -->
        <div id="history-view" class="hidden flex-1 flex flex-col w-full animate-fade-in">
            <div class="glass-card rounded-2xl p-5 mb-6 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex flex-1 flex-col sm:flex-row items-center gap-3 w-full">
                    <div class="relative w-full sm:w-72">
                        <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted"></i>
                        <input type="text" id="history-search-input" oninput="applyHistoryFilter()" placeholder="Tìm nhanh theo tên ngành..." class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-gray-50 border border-gray-200 text-sm outline-none focus:border-cyan">
                    </div>
                    <select id="history-time-filter" onchange="applyHistoryFilter()" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-gray-50 border border-gray-200 text-sm font-medium outline-none cursor-pointer">
                        <option value="all">Tất cả thời gian</option>
                        <option value="recent">Gần đây nhất (7 ngày)</option>
                        <option value="1month">1 tháng qua</option>
                        <option value="6months">6 tháng qua</option>
                    </select>
                </div>
                <div class="flex items-center gap-3 w-full md:w-auto justify-end">
                    <span class="text-xs font-bold text-muted uppercase">Sắp xếp:</span>
                    <select id="history-sort-filter" onchange="applyHistoryFilter()" class="px-4 py-2.5 rounded-xl bg-cyan/10 border-none text-cyan font-bold text-sm outline-none cursor-pointer">
                        <option value="date-desc">Mới nhất ➔ Cũ nhất</option>
                        <option value="date-asc">Cũ nhất ➔ Mới nhất</option>
                        <option value="score-desc">Tỷ lệ phù hợp (Cao ➔ Thấp)</option>
                    </select>
                    <button onclick="triggerCompareSelected()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-violet to-cyan text-white font-bold text-sm shadow hover-glow flex items-center gap-2 whitespace-nowrap">
                        <i data-lucide="copy"></i> So sánh (<span id="compare-count">0</span>)
                    </button>
                </div>
            </div>
            <div id="history-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full"></div>
        </div>

        <!-- ================= PHÂN HỆ 3: DỰ ĐOÁN TRÚNG TUYỂN ĐẠI HỌC ================= -->
        <div id="prediction-container" class="hidden flex-1 flex flex-col w-full animate-fade-in">
            <div class="glass-card rounded-3xl p-6 mb-6 border border-cyan/20 bg-white/80 shadow-md">
                <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-5">
                    <div class="space-y-3 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-xs font-bold text-muted uppercase tracking-wider">Hồ sơ trích xuất:</span>
                            <span class="text-xs font-bold bg-cyan/10 text-cyan px-3 py-1 rounded-full">Điểm thi THPT 2026</span>
                            <span class="text-xs font-bold bg-violet/10 text-violet px-3 py-1 rounded-full">Holland: <b id="pred-holland-badge">ISR</b></span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2.5">
                            <div class="px-3 py-1.5 rounded-xl bg-cyan/10 border border-cyan/20 text-xs"><span class="text-navy font-bold">Khối A01 (Toán, Lý, Anh):</span><span class="text-cyan font-black ml-1 text-sm" id="score-a01">25.50</span></div>
                            <div class="px-3 py-1.5 rounded-xl bg-violet/10 border border-violet/20 text-xs"><span class="text-navy font-bold">Khối D01 (Toán, Văn, Anh):</span><span class="text-violet font-black ml-1 text-sm" id="score-d01">24.50</span></div>
                            <div class="px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200 text-xs"><span class="text-muted font-medium">Khối A00 (Toán, Lý, Hóa):</span><span class="text-navy font-black ml-1 text-sm" id="score-a00">24.00</span></div>
                            <div class="px-3 py-1.5 rounded-xl bg-emerald/10 border border-emerald/20 text-xs"><span class="text-navy font-bold">Khối D07 (Toán, Hóa, Anh):</span><span class="text-emerald font-black ml-1 text-sm" id="score-d07">25.00</span></div>
                            <div class="px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200 text-xs"><span class="text-muted font-medium">Khối C00 (Văn, Sử, Địa):</span><span class="text-navy font-black ml-1 text-sm" id="score-c00">21.50</span></div>
                        </div>
                        <div class="text-xs text-muted flex flex-wrap gap-x-4 gap-y-1">
                            <span>Toán: <b class="text-navy" id="disp-toan">8.5</b></span><span>Văn: <b class="text-navy" id="disp-van">7.0</b></span><span>Anh: <b class="text-navy" id="disp-anh">9.0</b></span>
                            <span>Lý: <b class="text-navy" id="disp-ly">8.0</b></span><span>Hóa: <b class="text-navy" id="disp-hoa">7.5</b></span><span>Tin: <b class="text-navy" id="disp-tin">9.0</b></span>
                        </div>
                    </div>
                    <button onclick="openEditScoreModal()" class="px-5 py-2.5 rounded-xl border border-gray-200 text-navy font-bold text-xs hover:bg-cyan/5 hover:border-cyan hover:text-cyan flex items-center gap-2 shrink-0 transition-colors">
                        <i data-lucide="sliders-horizontal" class="w-4 h-4 text-cyan"></i> Chỉnh sửa điểm
                    </button>
                </div>
            </div>

            <div class="glass-card rounded-2xl p-5 mb-6 space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                    <div class="md:col-span-4 relative"><i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted"></i><input type="text" id="pred-filter-search" oninput="applyPredictionFilters()" placeholder="Tìm tên trường, tên ngành hoặc mã..." class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-gray-50 border border-gray-200 text-sm outline-none focus:border-cyan"></div>
                    <div class="md:col-span-2"><select id="pred-filter-region" onchange="applyPredictionFilters()" class="w-full px-3 py-2.5 rounded-xl bg-gray-50 border border-gray-200 text-sm font-medium outline-none cursor-pointer"><option value="all">Khu vực: Tất cả</option><option value="central">Miền Trung</option><option value="south">Miền Nam</option><option value="north">Miền Bắc</option></select></div>
                    <div class="md:col-span-2"><select id="pred-filter-method" onchange="applyPredictionFilters()" class="w-full px-3 py-2.5 rounded-xl bg-gray-50 border border-gray-200 text-sm font-medium outline-none cursor-pointer"><option value="all">Phương thức: Tất cả</option><option value="thpt">Xét điểm thi THPT</option><option value="hocba">Xét Học bạ THPT</option><option value="dgnl">Đánh giá năng lực</option><option value="kethop">Xét tuyển kết hợp</option></select></div>
                    <div class="md:col-span-2"><select id="pred-filter-group" onchange="applyPredictionFilters()" class="w-full px-3 py-2.5 rounded-xl bg-gray-50 border border-gray-200 text-sm font-medium outline-none cursor-pointer"><option value="all">Khối ngành: Tất cả</option><option value="it">Công nghệ thông tin & AI</option><option value="econ">Kinh tế & Quản trị</option><option value="eng">Kỹ thuật & Công nghệ</option><option value="health">Y - Dược</option></select></div>
                    <div class="md:col-span-2"><select id="pred-filter-risk" onchange="applyPredictionFilters()" class="w-full px-3 py-2.5 rounded-xl bg-cyan/10 border-none text-cyan font-bold text-sm outline-none cursor-pointer"><option value="all">Xác suất: Tất cả</option><option value="safe">🟢 An toàn (>85%)</option><option value="moderate">🟡 Cạnh tranh (60-85%)</option><option value="dream">🔴 Thách thức (<60%)</option></select></div>
                </div>
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pt-2 text-xs text-muted border-t border-gray-100 gap-2">
                    <div>Dự báo AI tìm thấy <span id="pred-result-count" class="font-bold text-navy">0</span> ngành phù hợp với điểm số của bạn</div>
                    <div class="flex items-center gap-3"><span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald"></span> An toàn (>85%)</span><span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Cạnh tranh (60-85%)</span><span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-500"></span> Thách thức (<60%)</span></div>
                </div>
            </div>

            <div id="prediction-cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10 w-full"></div>

            <section class="glass-card rounded-3xl p-8 border border-cyan/20 mb-8 bg-white/90">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                    <div>
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet/10 text-violet text-xs font-bold mb-1"><i data-lucide="sparkles" class="w-3.5 h-3.5"></i> AI Wishlist Optimizer</div>
                        <h3 class="text-xl font-black text-navy">Chiến Lược Tối Ưu Hóa Danh Sách Nguyện Vọng</h3>
                        <p class="text-xs text-muted mt-0.5">Sắp xếp nguyện vọng thông minh theo nguyên tắc bậc thang giảm thiểu rủi ro trượt đại học.</p>
                    </div>
                    <button onclick="autoOptimizeWishlist()" class="btn-gradient px-6 py-2.5 rounded-xl text-white font-bold text-xs shadow hover-glow flex items-center gap-2"><i data-lucide="wand-2" class="w-4 h-4"></i> AI Tự động xếp tối ưu</button>
                </div>
                <div class="space-y-3" id="wishlist-drag-container"></div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6 pt-6 border-t border-gray-100 text-xs">
                    <div class="p-3 bg-red-50/60 rounded-xl border border-red-100"><div class="font-bold text-red-600 mb-1">NV 1 - NV 2: Ước mơ / Thách thức</div><p class="text-muted">Các ngành điểm chuẩn dự kiến cao hơn điểm của bạn từ 0.5 - 1.5 điểm.</p></div>
                    <div class="p-3 bg-amber-50/60 rounded-xl border border-amber-100"><div class="font-bold text-amber-700 mb-1">NV 3 - NV 5: Vừa sức / Cạnh tranh</div><p class="text-muted">Điểm tương đương hoặc cao hơn điểm chuẩn dự kiến 0.25 - 1.0 điểm.</p></div>
                    <div class="p-3 bg-emerald-50/60 rounded-xl border border-emerald-100"><div class="font-bold text-emerald-700 mb-1">NV 6 trở đi: Lót nền / Chắc chắn đỗ</div><p class="text-muted">Điểm của bạn vượt xa điểm chuẩn từ 1.5 điểm trở lên, đảm bảo an toàn.</p></div>
                </div>
            </section>
        </div>
    </main>
</div>

<!-- ================= BOTTOM NAVIGATION BAR CHÍNH XÁC ================= -->
<nav id="bottom-nav-bar" class="fixed bottom-0 left-0 right-0 z-50 glass-card bg-white/95 backdrop-blur-2xl border-t border-navy/10 px-4 py-2.5 shadow-[0_-5px_25px_rgba(15,23,42,0.06)]">
    <div class="max-w-5xl mx-auto flex items-center justify-between gap-3 relative">
        
        <div class="flex items-center gap-2">
            <div class="hidden sm:flex items-center gap-2">
                <button id="bottom-btn-prediction" onclick="openPredictionView()" class="px-4 py-2 rounded-xl border border-slate-200 bg-white/80 text-navy font-bold text-xs hover:border-cyan hover:bg-cyan/5 hover:text-cyan flex items-center gap-1.5 transition-all duration-200 shadow-sm" title="Dự đoán xác suất trúng tuyển vào các trường đại học">
                    <i data-lucide="school" class="w-4 h-4 text-cyan"></i><span>Dự đoán trúng tuyển ĐH</span>
                </button>
                <button onclick="triggerChatbotModal()" class="px-4 py-2 rounded-xl border border-slate-200 bg-white/80 text-navy font-bold text-xs hover:border-cyan hover:bg-cyan/5 hover:text-cyan flex items-center gap-1.5 transition-all duration-200 shadow-sm" title="Trò chuyện với AI tư vấn hướng nghiệp">
                    <i data-lucide="message-square" class="w-4 h-4 text-violet"></i><span>Hỏi ChatBot AI</span>
                </button>
                <button id="bottom-btn-history" onclick="toggleHistoryView()" class="px-4 py-2 rounded-xl border border-slate-200 bg-white/80 text-navy font-bold text-xs hover:border-cyan hover:bg-cyan/5 hover:text-cyan flex items-center gap-1.5 transition-all duration-200 shadow-sm" title="Xem lại các lượt đánh giá đã lưu">
                    <i data-lucide="history" class="w-4 h-4 text-slate-500"></i><span>Lịch sử</span>
                </button>
            </div>
            <div class="relative sm:hidden flex items-center">
                <button id="btn-more-options" onclick="toggleMoreMenu(event)" class="p-2 rounded-xl border border-slate-200 hover:border-cyan hover:bg-cyan/5 text-navy transition-all focus:outline-none" title="Chức năng mở rộng"><i data-lucide="more-vertical" class="w-5 h-5"></i></button>
                <div id="floating-more-menu" class="hidden absolute bottom-12 left-0 w-60 glass-card bg-white/95 backdrop-blur-2xl rounded-2xl p-2 shadow-2xl border border-navy/10 flex-col gap-1 z-[70] animate-fade-in text-left">
