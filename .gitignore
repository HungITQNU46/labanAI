# Thư mục thư viện (bắt buộc chặn)
node_modules/

# Môi trường và biến ẩn (chứa API Key, mật khẩu DB)
.env
.env.local

# Log và cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Local ML input; contains personal data
/data_AI_1000_rows.xlsx
*.xlsx
*.xls

# Jupyter and Python test caches
/data/ml_pipeline/**/.ipynb_checkpoints/**
/data/ml_pipeline/**/__pycache__/
/data/ml_pipeline/**/.pytest_cache/
/.pytest_cache/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Serialized ML artifacts; do not commit binary models
/data/ml_pipeline/artifacts/**/*.joblib
/data/ml_pipeline/artifacts/**/*.pkl

